{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Understand Book",
  "version": "0.3.6",
  "identifier": "app.understandbook.reader",
  "build": {
    "beforeBuildCommand": "node scripts/assert-release-config.mjs && node scripts/build-local-reader.mjs",
    "frontendDist": "../local-reader"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
