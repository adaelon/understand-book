{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Understand Book Local",
  "version": "0.3.13",
  "identifier": "app.understandbook.local",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-resources.mjs",
    "frontendDist": "../../../crates/local-desktop-host/bootstrap"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/": "./" },
    "icon": [
      "../../../scripts/desktop/icons/32x32.png",
      "../../../scripts/desktop/icons/128x128.png",
      "../../../scripts/desktop/icons/128x128@2x.png",
      "../../../scripts/desktop/icons/icon.ico",
      "../../../scripts/desktop/icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
