      "index.html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>一张显卡能留住多少上下文：K/V 缓存与 24 GiB 容量账</title>\n<style>\n:root{\n  --canvas:#f5f7fa; --ink:#18202b; --surface:#ffffff; --line:#d6dce4; --accent:#2f6feb;\n  --muted:#5b6675; --warn:#b3392c; --seg-w:#7d8896; --seg-o:#aeb7c2; --free:#dfe6f0;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{background:var(--canvas);color:var(--ink);font:16px/1.72 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Noto Sans SC\",\"Microsoft YaHei\",sans-serif;-webkit-text-size-adjust:100%}\nmain{max-width:900px;margin:0 auto;padding:18px 14px 48px}\nh1{font-size:1.42rem;line-height:1.38;margin:8px 0 10px}\nh2{font-size:1.08rem;line-height:1.45;margin:28px 0 6px}\nh3{font-size:.98rem;margin:18px 0 4px;color:#101820}\np{margin:9px 0}\nul,ol{margin:8px 0;padding-left:1.3em}\nli{margin:6px 0}\n.lead{color:#22303f}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin:16px 0}\n.panel h2{margin-top:2px}\n.note{font-size:.86rem;color:var(--muted)}\n.formula{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9rem;background:#f1f5fa;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:10px 0;overflow-x:auto;white-space:nowrap}\ncode{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em;background:#eef2f8;border-radius:5px;padding:1px 5px}\n.chain{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:.9rem;margin:8px 0 0}\n.chip{border:1px solid var(--line);background:#f4f7fb;border-radius:999px;padding:5px 11px;white-space:nowrap}\n.op{color:var(--muted);font-weight:700}\n.result-chip{border-color:var(--accent);background:#eaf1fe;font-weight:700}\n.sketch{width:100%;height:auto;display:block;margin:12px 0 2px}\n.sketch text{font-size:9.5px;fill:var(--muted)}\n.sketch .blk-k{fill:#e8eefb;stroke:#8fb0ea}\n.sketch .blk-v{fill:#e9f2e8;stroke:#9cbf9b}\n.sketch .div-k{stroke:#8fb0ea;stroke-width:1}\n.sketch .div-v{stroke:#9cbf9b;stroke-width:1}\n.sketch .box{stroke:var(--line);stroke-width:1;fill:#fbfcfe}\n.controls{display:grid;gap:14px}\n.ctrl{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:2px 10px}\n.ctrl label{font-weight:600;display:flex;flex-wrap:wrap;gap:6px;align-items:baseline;min-width:0}\n.ctrl .hint{font-weight:400;color:var(--muted);font-size:.82rem}\n.ctrl output{grid-column:2;grid-row:1;font-variant-numeric:tabular-nums;font-weight:700;color:var(--accent);white-space:nowrap}\n.ctrl input[type=range]{grid-column:1/-1;grid-row:2;width:100%;height:44px;margin:0;accent-color:var(--accent)}\n.ctrl select{grid-column:1/-1;grid-row:2;width:100%;min-height:44px;font-size:1rem;padding:6px 10px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n.presets{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.presets button{min-height:44px;min-width:44px;padding:8px 14px;font-size:.9rem;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:10px;cursor:pointer}\n.presets button:active{background:#e9eff8}\n.presets button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n.bar-title{font-size:.86rem;color:var(--muted);margin:18px 0 6px}\n.track{display:flex;width:100%;height:34px;border-radius:8px;overflow:hidden;border:1px solid var(--line);background:#fff}\n.seg{height:100%;transition:width .16s linear}\n.seg-w{background:var(--seg-w)}\n.seg-o{background:var(--seg-o)}\n.seg-kv{background:var(--accent)}\n.seg-free{background:var(--free)}\n.track-ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-top:4px}\n.legend{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:6px 14px;padding:0;margin:12px 0 0;font-size:.88rem}\n.legend li{display:flex;align-items:center;gap:8px;min-width:0;margin:0}\n.sw{width:14px;height:14px;border-radius:4px;flex:none;border:1px solid rgba(0,0,0,.15)}\n.legend b{font-variant-numeric:tabular-nums}\n.over{margin-top:12px;border-top:1px dashed var(--line);padding-top:10px}\n.track-over .seg-over{background:repeating-linear-gradient(45deg,var(--warn),var(--warn) 6px,#d98a80 6px,#d98a80 12px)}\n.verdict{margin:14px 0 0;padding:11px 13px;border-radius:12px;font-weight:600;border:1px solid var(--line);background:#f0f6ff}\n.verdict.bad{background:#fdf1ef;border-color:#e7c3bd;color:#7d2418}\n.verdict.exact{background:#effaf1;border-color:#bfe3c6}\n.readouts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:10px;margin-top:14px}\n.card{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:#fbfcfe;min-width:0}\n.card .k{font-size:.82rem;color:var(--muted)}\n.card .v{font-size:1.1rem;font-weight:700;font-variant-numeric:tabular-nums;margin:2px 0;overflow-wrap:anywhere}\n.card .note{font-size:.78rem;line-height:1.55}\n.answers{display:grid;gap:10px;margin-top:14px}\n.answers p{margin:0;padding:11px 13px;border:1px solid var(--line);border-radius:12px;background:#fbfcfe;font-size:.93rem}\n.answers b{font-variant-numeric:tabular-nums}\n.steps{margin:10px 0 0;padding-left:1.35em}\n.steps li{margin:8px 0}\ntable.cmp{width:100%;border-collapse:collapse;margin:10px 0;font-size:.9rem}\ntable.cmp th,table.cmp td{border:1px solid var(--line);padding:7px 9px;text-align:left;vertical-align:top}\ntable.cmp th{background:#f1f5fa;font-weight:600}\n@media (max-width:420px){\n  table.cmp{font-size:.84rem}\n  table.cmp th,table.cmp td{padding:6px 7px}\n}\n</style>\n</head>\n<body>\n<main>\n<h1>一张显卡能留住多少上下文</h1>\n<p class=\"lead\">模型装进 24 GiB 显卡之后，有两块占用就固定了：模型权重 10 GiB，其他运行开销 2 GiB，合计 <b>12 GiB 固定占用</b>。此后仍然会往上涨的，是给每个已缓存 token 保存的 K/V 缓存。这篇讲解先说明这份缓存记住的是什么，再解释 32、8、128、B、T、s 这些数为什么连乘，最后落到\"这台机器装不装得下\"的判断，并附一个可以自己拖动参数的计算器。</p>\n\n<section class=\"panel\">\n<h2>一、K/V 缓存记住的是什么</h2>\n<p>模型在每一层处理一个 token 时，会用这一层的权重把它变成一对向量。K 向量像这张 token 的\"检索标签\"，同一层里，后面进到这个位置的 token 靠它判断该关注前面哪些位置；V 向量是被关注时真正被取走的内容。这对向量算过一次就不会再变，后面每来一个新 token 都要回头和全部历史比对，所以必须把它们存下来重复使用。缓存里存的就是这些已经算过的 K 和 V。</p>\n<p>存的位置不止一份。32 层各有各的 K/V，因为每层的向量不同；同一层里 8 个缓存头各自独立保存；每个头的每个向量有 128 个元素。于是\"一个 token 在一条序列里\"留下的记录，可以画成这样（图中只画 3 层、每层 8 个头，实际是 32 层）：</p>\n<p style=\"font-size:.84rem;color:#5b6675;margin:4px 0 14px\">示意图只表示「每个头都要各存一份」，格子宽度不代表占用比例：K 与 V 形状相同，各占一半，每个头也一样大。</p>\n\n<svg class=\"sketch\" viewBox=\"0 0 340 118\" role=\"img\" aria-label=\"示意图：一个 token 在每层、每个缓存头都要保存一份 K 向量和一份 V 向量；每个小格是一个头，向量长 128 个元素\">\n  <text x=\"56\" y=\"11\">K 向量（每个头 128 个元素）</text>\n  <text x=\"232\" y=\"11\">V 向量</text>\n\n  <text x=\"0\" y=\"30\">第 1 层</text>\n  <rect class=\"blk-k\" x=\"56\" y=\"19\" width=\"150\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-k\" x1=\"74.75\" y1=\"19\" x2=\"74.75\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"93.5\" y1=\"19\" x2=\"93.5\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"112.25\" y1=\"19\" x2=\"112.25\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"131\" y1=\"19\" x2=\"131\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"149.75\" y1=\"19\" x2=\"149.75\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"168.5\" y1=\"19\" x2=\"168.5\" y2=\"34\"></line>\n  <line class=\"div-k\" x1=\"187.25\" y1=\"19\" x2=\"187.25\" y2=\"34\"></line>\n  <rect class=\"blk-v\" x=\"232\" y=\"19\" width=\"108\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-v\" x1=\"245.5\" y1=\"19\" x2=\"245.5\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"259\" y1=\"19\" x2=\"259\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"272.5\" y1=\"19\" x2=\"272.5\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"286\" y1=\"19\" x2=\"286\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"299.5\" y1=\"19\" x2=\"299.5\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"313\" y1=\"19\" x2=\"313\" y2=\"34\"></line>\n  <line class=\"div-v\" x1=\"326.5\" y1=\"19\" x2=\"326.5\" y2=\"34\"></line>\n\n  <text x=\"0\" y=\"54\">第 2 层</text>\n  <rect class=\"blk-k\" x=\"56\" y=\"43\" width=\"150\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-k\" x1=\"74.75\" y1=\"43\" x2=\"74.75\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"93.5\" y1=\"43\" x2=\"93.5\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"112.25\" y1=\"43\" x2=\"112.25\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"131\" y1=\"43\" x2=\"131\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"149.75\" y1=\"43\" x2=\"149.75\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"168.5\" y1=\"43\" x2=\"168.5\" y2=\"58\"></line>\n  <line class=\"div-k\" x1=\"187.25\" y1=\"43\" x2=\"187.25\" y2=\"58\"></line>\n  <rect class=\"blk-v\" x=\"232\" y=\"43\" width=\"108\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-v\" x1=\"245.5\" y1=\"43\" x2=\"245.5\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"259\" y1=\"43\" x2=\"259\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"272.5\" y1=\"43\" x2=\"272.5\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"286\" y1=\"43\" x2=\"286\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"299.5\" y1=\"43\" x2=\"299.5\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"313\" y1=\"43\" x2=\"313\" y2=\"58\"></line>\n  <line class=\"div-v\" x1=\"326.5\" y1=\"43\" x2=\"326.5\" y2=\"58\"></line>\n\n  <text x=\"0\" y=\"77\">⋮</text>\n  <text x=\"56\" y=\"77\">⋮</text>\n  <text x=\"232\" y=\"77\">⋮</text>\n\n  <text x=\"0\" y=\"101\">第 32 层</text>\n  <rect class=\"blk-k\" x=\"56\" y=\"90\" width=\"150\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-k\" x1=\"74.75\" y1=\"90\" x2=\"74.75\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"93.5\" y1=\"90\" x2=\"93.5\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"112.25\" y1=\"90\" x2=\"112.25\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"131\" y1=\"90\" x2=\"131\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"149.75\" y1=\"90\" x2=\"149.75\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"168.5\" y1=\"90\" x2=\"168.5\" y2=\"105\"></line>\n  <line class=\"div-k\" x1=\"187.25\" y1=\"90\" x2=\"187.25\" y2=\"105\"></line>\n  <rect class=\"blk-v\" x=\"232\" y=\"90\" width=\"108\" height=\"15\" rx=\"2\"></rect>\n  <line class=\"div-v\" x1=\"245.5\" y1=\"90\" x2=\"245.5\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"259\" y1=\"90\" x2=\"259\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"272.5\" y1=\"90\" x2=\"272.5\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"286\" y1=\"90\" x2=\"286\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"299.5\" y1=\"90\" x2=\"299.5\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"313\" y1=\"90\" x2=\"313\" y2=\"105\"></line>\n  <line class=\"div-v\" x1=\"326.5\" y1=\"90\" x2=\"326.5\" y2=\"105\"></line>\n</svg>\n<p class=\"note\">示意：每行是一层，每格是一个缓存头，左块是 K、右块是 V；实际每行 8 个格、每格 128 个元素。整张表只对应\"一个 token 在一条序列里\"。</p>\n\n<p>这里回答了你最初的疑问：权重是模型装进去就定下来的常量，缓存是运行期不断追加的记录。对话每多一个 token，每条序列就多一行这样的记录；只要这条对话还活着，旧记录就不能扔，因为下一个 token 还要回头看全部历史。同时服务多个用户时，每条对话各自留一份，互不共享。所以模型装好之后，显存还会继续往上涨。</p>\n</section>\n\n<section class=\"panel\">\n<h2>二、这些数为什么要相乘</h2>\n<p>用你熟悉的话说：把一条序列的缓存看成一个数组，维度依次是 [token][层][头][K 或 V][元素]。数组里元素的总数等于各维长度相乘，因为每一维上的每一种取值组合都对应一个真实存下来的数，没有任何两组组合共用同一个格子。这正是连乘的理由。</p>\n<div class=\"chain\">\n<span class=\"chip\">32 层</span><span class=\"op\">×</span>\n<span class=\"chip\">8 个头</span><span class=\"op\">×</span>\n<span class=\"chip\">K、V 各一份 = 2</span><span class=\"op\">×</span>\n<span class=\"chip\">128 元素</span><span class=\"op\">=</span>\n<span class=\"chip result-chip\">65,536 元素 /（token·序列）</span>\n</div>\n<p class=\"note\">这个 65,536 只和模型结构有关，与 B、T、s 都无关：它是\"一个 token 在一条序列里\"的记录量。它同时也是 2 的整数次幂（2¹⁶），后面的除法因此很干净。</p>\n<p>三个可调参数分别放大其中一维：</p>\n<ul>\n<li><b>B（并发序列数）</b>放大\"序列\"这一维。B 条对话各有一份完整记录，内容不共享，所以整张表复制 B 份。</li>\n<li><b>T（每条序列的缓存长度）</b>放大\"token\"这一维：一条序列上一共存了多少个 token 的记录。</li>\n<li><b>s（每个元素几个字节）</b>不增加元素个数，它把元素数换算成字节数。</li>\n</ul>\n<div class=\"formula\">KV 字节数 = B × T × 32 × 8 × 2 × 128 × s = B × T × 65,536 × s</div>\n<div class=\"formula\">KV 缓存（GiB）= B × T × 65,536 × s ÷ 2³⁰ = B × T × s ÷ 16,384</div>\n<p>第二个式子里的 16,384 只来自单位换算：65,536 ÷ 2³⁰ = 1 ÷ 16,384。它和你的参数无关，也不代表新增了什么物理量。判断容量时用 GiB 计，比一路数到十亿字节要省事。</p>\n</section>\n\n<section class=\"panel\">\n<h2>三、固定占用与会增长的占用</h2>\n<p>这台机器的账分两块：</p>\n<table class=\"cmp\">\n<tr><th>占用</th><th>这次模型里的数值</th><th>由什么决定</th></tr>\n<tr><td>模型权重</td><td>10 GiB</td><td>模型装进显卡时定下来，运行中不变</td></tr>\n<tr><td>其他运行开销</td><td>2 GiB</td><td>固定，与 B、T、s 无关</td></tr>\n<tr><td>K/V 缓存</td><td>B × T × s ÷ 16,384 GiB</td><td>随并发数、缓存长度、每元素字节数增长</td></tr>\n</table>\n<div class=\"formula\">合计占用 = 12 GiB + B × T × s ÷ 16,384 GiB ≤ 24 GiB</div>\n<p>把固定部分扣掉，留给 K/V 缓存的上限就是 24 − 12 = <b>12 GiB</b>。所以判断装不装得下，等价于问一句：KV 缓存有没有超过 12 GiB。恰好等于 12 GiB（也就是合计恰好 24 GiB）时容量用满但没溢出，算装得下。</p>\n</section>\n\n<section class=\"panel\">\n<h2>四、用初始参数算一遍：B＝4、T＝8192、s＝2</h2>\n<ol class=\"steps\">\n<li>一个 token 的元素数：32 × 8 × 2 × 128 = <b>65,536</b> 个元素；乘 s＝2 字节，得 <b>131,072 字节</b>，也就是 128 KiB。</li>\n<li>一条序列：8192 个 token × 128 KiB = 1,048,576 KiB = 1024 MiB = <b>1 GiB</b>。</li>\n<li>四条序列：4 × 1 GiB = <b>4 GiB</b> 的 KV 缓存。</li>\n<li>合计：12 GiB 固定占用 + 4 GiB = <b>16 GiB</b>，低于 24 GiB，还剩 <b>8 GiB</b>。</li>\n</ol>\n<p>直接用公式一步校验：4 × 8192 × 2 ÷ 16,384 = 65,536 ÷ 16,384 = 4 GiB，与逐条相加的结果一致。这一步值得动手核一次，因为后面所有判断都用同一把尺子。</p>\n</section>\n\n<section class=\"panel\">\n<h2>五、拖动参数，看这 24 GiB 还剩多少</h2>\n<div class=\"controls\">\n  <div class=\"ctrl\">\n    <label for=\"bRange\">并发序列数 B <span class=\"hint\">1–16，整数</span></label>\n    <output id=\"bOut\" for=\"bRange\">4</output>\n    <input id=\"bRange\" type=\"range\" min=\"1\" max=\"16\" step=\"1\" value=\"4\" data-presentation-parameter=\"B\">\n  </div>\n  <div class=\"ctrl\">\n    <label for=\"tRange\">每条序列的缓存长度 T <span class=\"hint\">0–32768 token，整数</span></label>\n    <output id=\"tOut\" for=\"tRange\">8,192</output>\n    <input id=\"tRange\" type=\"range\" min=\"0\" max=\"32768\" step=\"1\" value=\"8192\" data-presentation-parameter=\"T\">\n  </div>\n  <div class=\"ctrl\">\n    <label for=\"sSelect\">每个缓存元素占 s 字节 <span class=\"hint\">只改变 KV 缓存大小</span></label>\n    <output id=\"sOut\" for=\"sSelect\">2</output>\n    <select id=\"sSelect\" data-presentation-parameter=\"s\">\n      <option value=\"1\">1 字节 / 元素</option>\n      <option value=\"2\" selected>2 字节 / 元素</option>\n      <option value=\"4\">4 字节 / 元素</option>\n    </select>\n  </div>\n</div>\n<div class=\"presets\" role=\"group\" aria-label=\"参数预设\">\n  <button type=\"button\" data-preset=\"4,8192,2\">初始：4 / 8192 / 2</button>\n  <button type=\"button\" data-preset=\"4,8192,1\">s 减半：4 / 8192 / 1</button>\n  <button type=\"button\" data-preset=\"4,24576,2\">恰好装满：4 / 24576 / 2</button>\n  <button type=\"button\" data-preset=\"16,32768,4\">装不下：16 / 32768 / 4</button>\n  <button type=\"button\" data-preset=\"4,0,2\">没有缓存：4 / 0 / 2</button>\n</div>\n\n<p class=\"bar-title\">整条宽度 = 24 GiB 上限。深蓝是随参数变化的 KV 缓存，浅灰是还没用到的空间；超出容量时，下面会单独画一条橙红条纹，长度表示超出多少。</p>\n<div class=\"track\" id=\"track\" role=\"img\" aria-label=\"24 GiB 显存占用构成条：模型权重、其他运行开销、KV 缓存、剩余空间\">\n  <div class=\"seg seg-w\" id=\"segW\" style=\"width:41.6667%\"></div>\n  <div class=\"seg seg-o\" id=\"segO\" style=\"width:8.3333%\"></div>\n  <div class=\"seg seg-kv\" id=\"segKV\" style=\"width:16.6667%\"></div>\n  <div class=\"seg seg-free\" id=\"segFree\" style=\"width:33.3333%\"></div>\n</div>\n<div class=\"track-ends\"><span>0 GiB</span><span>整条 = 24 GiB 上限</span></div>\n<div class=\"over\" id=\"overWrap\" hidden>\n  <div class=\"track track-over\" aria-hidden=\"true\">\n    <div class=\"seg seg-over\" id=\"segOver\" style=\"width:0%\"></div>\n  </div>\n  <div class=\"note\" id=\"overLabel\"></div>\n</div>\n<ul class=\"legend\">\n  <li><span class=\"sw\" style=\"background:var(--seg-w)\"></span>模型权重 <b id=\"lgW\">10 GiB</b></li>\n  <li><span class=\"sw\" style=\"background:var(--seg-o)\"></span>其他运行开销 <b id=\"lgO\">2 GiB</b></li>\n  <li><span class=\"sw\" style=\"background:var(--accent)\"></span>K/V 缓存 <b id=\"lgKV\">4 GiB</b></li>\n  <li><span class=\"sw\" id=\"lgFreeSwatch\" style=\"background:var(--free);border-color:#c7cedb\"></span><span id=\"lgFreeKey\">剩余空间</span> <b id=\"lgFree\">8 GiB</b></li>\n</ul>\n<p class=\"verdict\" id=\"verdict\" aria-live=\"polite\">装得下：KV 缓存 4 GiB，合计 16 GiB，还剩 8 GiB 没用到。</p>\n\n<div class=\"readouts\">\n  <div class=\"card\"><div class=\"k\">每个 token 的元素数</div><div class=\"v\" id=\"vElem\">65,536 个</div><div class=\"note\">32 层 × 8 头 × 2（K、V）× 128 元素，与 B、T、s 无关</div></div>\n  <div class=\"card\"><div class=\"k\">每个 token 的字节数</div><div class=\"v\" id=\"vBpt\">131,072 字节</div><div class=\"note\" id=\"nBpt\"></div></div>\n  <div class=\"card\"><div class=\"k\">每条序列的 K/V 缓存</div><div class=\"v\" id=\"vPerSeq\">1 GiB</div><div class=\"note\" id=\"nPerSeq\"></div></div>\n  <div class=\"card\"><div class=\"k\">K/V 缓存合计</div><div class=\"v\" id=\"vKV\">4 GiB</div><div class=\"note\" id=\"nKV\"></div></div>\n  <div class=\"card\"><div class=\"k\">合计占用</div><div class=\"v\" id=\"vTotal\">16 GiB</div><div class=\"note\" id=\"nTotal\"></div></div>\n  <div class=\"card\"><div class=\"k\" id=\"kMargin\">剩余空间</div><div class=\"v\" id=\"vMargin\">8 GiB</div><div class=\"note\" id=\"nMargin\"></div></div>\n</div>\n\n<div class=\"answers\">\n  <p id=\"maxT\"></p>\n  <p id=\"marginal\"></p>\n  <p id=\"doubling\"></p>\n</div>\n</section>\n\n<section class=\"panel\">\n<h2>六、你最后要能自己回答的三个问题</h2>\n\n<h3>1. 增加一条同样长的序列，要多占多少空间</h3>\n<p>只改 B，T 和 s 不动，那么新增的是整整一条序列的记录，也就是 T × s ÷ 16,384 GiB。初始参数下是 8192 × 2 ÷ 16,384 = <b>1 GiB</b>。这个代价随条数线性叠加：B 从 4 到 5，KV 缓存从 4 GiB 变成 5 GiB，合计从 16 GiB 变成 17 GiB；再加一条就再多 1 GiB。所以并发数和 KV 缓存是正比关系，没有\"第二条更便宜\"的折扣。</p>\n\n<h3>2. 长度翻倍时，哪些量翻倍，哪些不翻</h3>\n<p>翻倍的是和 token 数直接相连的量：每条序列缓存的行数、KV 缓存的元素数、KV 缓存的字节数，以及 KV 缓存占用的那块显存。初始参数下 T 从 8192 到 16,384，KV 缓存从 4 GiB 变成 8 GiB，每条序列从 1 GiB 变成 2 GiB。</p>\n<p>保持不变的是：固定的 12 GiB、每个 token 仍然占 65,536 个元素、每个元素仍是 s 字节、24 GiB 的上限也没有变。因此合计占用只是\"固定部分 + 翻倍的缓存\"，从 16 GiB 变成 20 GiB。把合计也当成翻倍（以为要 32 GiB）是这一步最容易出的错。</p>\n\n<h3>3. 这组参数还能容纳多长的上下文</h3>\n<p>把判据当成不等式解：B × T × s ÷ 16,384 ≤ 12，两边整理得 T ≤ 196,608 ÷ (B × s)，再向下取整。初始 B＝4、s＝2 时，196,608 ÷ 8 = <b>24,576</b> 个 token。也就是说每条序列从现在的 8192 还能涨到 24,576，再多就溢出。</p>\n<p>如果算出的上限超过 32,768，实际就受参数上限 32,768 的约束：例如 B＝1、s＝2 时容量允许 98,304 个 token，但这个模型里 T 只到 32,768，此时 KV 缓存只用了 4 GiB。恰好取到上限值时 KV 缓存正好 12 GiB、合计正好 24 GiB，属于装得下。</p>\n</section>\n\n<section class=\"panel\">\n<h2>七、装不下的情形怎么读</h2>\n<p>合计占用超过 24 GiB 就是装不下，缺口有确切的大小：</p>\n<div class=\"formula\">超出量 = 合计 − 24 GiB = KV 缓存 − 12 GiB</div>\n<p>换句更直观的话：超出量就是 KV 缓存越过 12 GiB 这条线的部分。举一个明确装不下的组合：B＝16、T＝32768、s＝4。先算 KV 缓存：16 × 32768 × 4 = 2,097,152，再 ÷ 16,384 = <b>128 GiB</b>；合计 12 + 128 = <b>140 GiB</b>，比上限多出 <b>116 GiB</b>。这个数字说明，光靠调度省一点没用，必须改参数：这一组里 T 要降到 196,608 ÷ (16 × 4) = <b>3,072</b> 才刚好装满；把 s 换小或把并发降下来也同样有效。</p>\n<p>反过来看，这条判据也有一个乐观的地方需要清醒对待：本模型没有计入分块留白、内存碎片和临时分配。真实机器上按这里算出的上限去配置，会比\"刚好装满\"更紧一些，因为那些开销还要再从余量里扣。</p>\n</section>\n\n<section class=\"panel\">\n<h2>八、一页速查</h2>\n<ul>\n<li>一个 token 在一条序列里：32 × 8 × 2 × 128 = <b>65,536 个元素</b>，与 B、T、s 无关。</li>\n<li>字节数：<b>B × T × 65,536 × s</b>；换成 GiB 就是 <b>B × T × s ÷ 16,384</b>。</li>\n<li>合计占用：<b>12 GiB + KV 缓存</b>；留给 KV 的上限是 <b>12 GiB</b>。</li>\n<li>判据：KV 缓存 ≤ 12 GiB 装得下；等于 12 GiB 也算装得下；超过多少，就超出 24 GiB 多少。</li>\n<li>加一条序列：多占 <b>T × s ÷ 16,384 GiB</b>，与条数成正比。</li>\n<li>T 翻倍：KV 缓存翻倍，固定 12 GiB 不翻，合计不会翻倍。</li>\n<li>还能留多长：<b>T ≤ 196,608 ÷ (B × s)</b>，向下取整，且不超过 32,768。</li>\n</ul>\n<p class=\"note\">这套算式只覆盖本题给出的教学模型：权重 10 GiB、其他开销 2 GiB、32 层的 8 个缓存头、每头 128 个元素，1 GiB 按 2³⁰ 字节计，不计留白、碎片和临时分配。换模型时，把 65,536 换成新模型的（层数 × 头数 × 2 × 每头元素数），其余步骤不变。</p>\n</section>\n\n</main>\n\n<script>\n(function(){\n  var GIB = 1073741824, ELEM = 65536, FIXED = 12, CAP = 24, KV_MAX = 12, T_CAP = 32768, TOKENS_BUDGET = 196608;\n  var bR = document.getElementById('bRange');\n  var tR = document.getElementById('tRange');\n  var sR = document.getElementById('sSelect');\n  var bOut = document.getElementById('bOut');\n  var tOut = document.getElementById('tOut');\n  var sOut = document.getElementById('sOut');\n  var segW = document.getElementById('segW'), segO = document.getElementById('segO'),\n      segKV = document.getElementById('segKV'), segFree = document.getElementById('segFree');\n  var overWrap = document.getElementById('overWrap'), segOver = document.getElementById('segOver'),\n      overLabel = document.getElementById('overLabel');\n  var lgKV = document.getElementById('lgKV'), lgFree = document.getElementById('lgFree'),\n      lgFreeKey = document.getElementById('lgFreeKey'), lgFreeSwatch = document.getElementById('lgFreeSwatch');\n  var verdict = document.getElementById('verdict');\n  var vElem = document.getElementById('vElem'), vBpt = document.getElementById('vBpt'), nBpt = document.getElementById('nBpt');\n  var vPerSeq = document.getElementById('vPerSeq'), nPerSeq = document.getElementById('nPerSeq');\n  var vKV = document.getElementById('vKV'), nKV = document.getElementById('nKV');\n  var vTotal = document.getElementById('vTotal'), nTotal = document.getElementById('nTotal');\n  var kMargin = document.getElementById('kMargin'), vMargin = document.getElementById('vMargin'), nMargin = document.getElementById('nMargin');\n  var maxT = document.getElementById('maxT'), marginal = document.getElementById('marginal'), doubling = document.getElementById('doubling');\n  var cur = null;\n  var EPS = 1e-9;\n\n  function fmt(x, d){\n    var f = Math.pow(10, d);\n    var r = Math.round(x * f) / f;\n    return r.toLocaleString('zh-CN', {maximumFractionDigits: d});\n  }\n  function G(x){ return fmt(x, 4) + ' GiB'; }\n  function BZ(n){ return n.toLocaleString('zh-CN') + ' 字节'; }\n  function human(n){\n    if (n === 0) return '0';\n    if (n % GIB === 0) return (n / GIB).toLocaleString('zh-CN') + ' GiB';\n    if (n % 1048576 === 0) return (n / 1048576).toLocaleString('zh-CN') + ' MiB';\n    if (n % 1024 === 0) return (n / 1024).toLocaleString('zh-CN') + ' KiB';\n    return BZ(n);\n  }\n\n  function render(){\n    var B = +bR.value, T = +tR.value, s = +sR.value;\n    var kv = B * T * s / 16384;\n    var total = FIXED + kv;\n    var free = CAP - total;\n    var raw = Math.floor(TOKENS_BUDGET / (B * s));\n    var tmax = Math.min(T_CAP, raw);\n    var perSeq = T * s / 16384;\n    cur = {B:B, T:T, s:s, kv:kv, total:total, free:free, tmax:tmax, perSeq:perSeq, raw:raw};\n\n    bOut.textContent = String(B);\n    tOut.textContent = fmt(T, 0);\n    sOut.textContent = String(s);\n\n    segW.style.width = (10 / CAP * 100) + '%';\n    segO.style.width = (2 / CAP * 100) + '%';\n    segKV.style.width = (Math.min(kv, KV_MAX) / CAP * 100) + '%';\n    segFree.style.width = (Math.max(0, KV_MAX - kv) / CAP * 100) + '%';\n\n    lgKV.textContent = G(kv);\n    if (kv > KV_MAX + EPS){\n      lgFreeKey.textContent = '超出容量';\n      lgFree.textContent = G(kv - KV_MAX);\n      lgFreeSwatch.style.background = 'var(--warn)';\n      lgFreeSwatch.style.borderColor = 'var(--warn)';\n    } else {\n      lgFreeKey.textContent = '剩余空间';\n      lgFree.textContent = G(KV_MAX - kv);\n      lgFreeSwatch.style.background = 'var(--free)';\n      lgFreeSwatch.style.borderColor = '#c7cedb';\n    }\n\n    if (kv > KV_MAX + EPS){\n      var over = kv - KV_MAX;\n      overWrap.hidden = false;\n      segOver.style.width = (Math.min(over, CAP) / CAP * 100) + '%';\n      overLabel.textContent = '橙红条纹 = 超出 24 GiB 上限的 ' + G(over) + (over > CAP ? '（这条只画到 24 GiB 宽，实际超出更多）' : '');\n    } else {\n      overWrap.hidden = true;\n    }\n\n    if (kv > KV_MAX + EPS){\n      verdict.className = 'verdict bad';\n      verdict.textContent = '装不下：K/V 缓存需要 ' + G(kv) + '，合计 ' + G(total) + '，比 24 GiB 上限多出 ' + G(kv - KV_MAX) + '。';\n    } else if (kv >= KV_MAX - EPS){\n      verdict.className = 'verdict exact';\n      verdict.textContent = '装得下：K/V 缓存正好 ' + G(KV_MAX) + '，合计恰好 24 GiB，容量用满，仍算装得下。';\n    } else {\n      verdict.className = 'verdict';\n      verdict.textContent = '装得下：K/V 缓存 ' + G(kv) + '，合计 ' + G(total) + '，还剩 ' + G(KV_MAX - kv) + ' 没用到。';\n    }\n\n    vElem.textContent = '65,536 个';\n    vBpt.textContent = BZ(ELEM * s);\n    nBpt.textContent = '= 65,536 元素 × ' + s + ' 字节（' + human(ELEM * s) + '）；s 只改字节数，元素个数不变';\n\n    vPerSeq.textContent = G(perSeq);\n    nPerSeq.textContent = '= T（' + fmt(T, 0) + ' 个 token）× 每 token ' + human(ELEM * s) + '（' + BZ(T * ELEM * s) + '）';\n\n    vKV.textContent = G(kv);\n    nKV.textContent = '= B（' + B + ' 条）× 每条 ' + G(perSeq) + (kv > 0 ? '，共 ' + BZ(B * T * ELEM * s) : '');\n\n    vTotal.textContent = G(total);\n    nTotal.textContent = '= 12 GiB 固定占用 + K/V 缓存 ' + G(kv);\n\n    if (free >= 0){\n      kMargin.textContent = '剩余空间';\n      vMargin.textContent = G(free);\n      vMargin.style.color = '';\n      nMargin.textContent = '= 24 GiB − 合计占用；恰好 0 也算装得下';\n    } else {\n      kMargin.textContent = '超出多少';\n      vMargin.textContent = G(-free);\n      vMargin.style.color = 'var(--warn)';\n      nMargin.textContent = '= 合计占用 − 24 GiB，也就是 K/V 缓存越过 12 GiB 的部分';\n    }\n\n    var a1 = '还能留多长：B＝' + B + '、s＝' + s + ' 时，留给 K/V 缓存的 12 GiB 最多支撑 T＝' + fmt(tmax, 0) + ' 个 token 的上下文。';\n    if (raw > T_CAP){\n      a1 += '容量侧算出的上限是 ' + fmt(raw, 0) + '，但本模型的 T 只到 32,768，所以实际取 32,768。';\n    }\n    if (T < tmax){\n      a1 += '当前 T＝' + fmt(T, 0) + '，还能再加 ' + fmt(tmax - T, 0) + ' 个 token。';\n    } else if (T === tmax){\n      a1 += '当前 T＝' + fmt(T, 0) + ' 正好压在这个上限上：K/V 缓存正好 12 GiB，合计正好 24 GiB，恰好装满，仍算装得下。';\n    } else {\n      a1 += '当前 T＝' + fmt(T, 0) + ' 已经超出上限 ' + fmt(T - tmax, 0) + ' 个 token，所以装不下。';\n    }\n    maxT.textContent = a1;\n\n    var a2 = '多一条同样长的序列：T 和 s 不变时，每多一条序列多占 ' + G(perSeq) + '（= T × s ÷ 16,384）。';\n    if (B >= 16){\n      a2 += 'B 已经是上限 16，加不了第 17 条。';\n    } else {\n      a2 += 'B 从 ' + B + ' 加到 ' + (B + 1) + ' 时，K/V 缓存从 ' + G(kv) + ' 变成 ' + G(kv + perSeq) + '，合计从 ' + G(total) + ' 变成 ' + G(total + perSeq) + '。';\n    }\n    if (perSeq === 0){\n      a2 += 'T＝0 时没有 token 需要缓存，多加序列也不增加 K/V 缓存。';\n    }\n    marginal.textContent = a2;\n\n    var a3;\n    if (T === 0){\n      a3 = 'T＝0 时没有任何 token 被缓存，K/V 缓存是 0 GiB，合计只有固定的 12 GiB；把它翻倍仍然是 0。';\n    } else {\n      a3 = 'T 翻倍：从 ' + fmt(T, 0) + ' 到 ' + fmt(2 * T, 0) + ' 时，每条序列的行数、K/V 缓存的元素数、字节数和占用量都翻一倍，K/V 缓存从 ' + G(kv) + ' 到 ' + G(2 * kv) + '；固定的 12 GiB 不翻倍，所以合计从 ' + G(total) + ' 变成 ' + G(12 + 2 * kv) + '。';\n      if (2 * T > T_CAP){\n        a3 += '（2 × T 已超过本模型的 32,768 上限，界面只画到上限，倍数关系本身不变。）';\n      }\n    }\n    doubling.textContent = a3;\n  }\n\n  bR.addEventListener('input', render);\n  tR.addEventListener('input', render);\n  sR.addEventListener('input', render);\n  bR.addEventListener('change', render);\n  tR.addEventListener('change', render);\n  sR.addEventListener('change', render);\n\n  var presets = document.querySelectorAll('[data-preset]');\n  for (var i = 0; i < presets.length; i++){\n    (function(btn){\n      btn.addEventListener('click', function(){\n        var p = btn.getAttribute('data-preset').split(',').map(Number);\n        bR.value = String(p[0]);\n        tR.value = String(p[1]);\n        sR.value = String(p[2]);\n        render();\n        try {\n          if (window.presentation && window.presentation.commitState) window.presentation.commitState();\n        } catch (e) {}\n      });\n    })(presets[i]);\n  }\n\n  var P = window.presentation;\n  if (P && P.registerStateReader){\n    P.registerStateReader(function(){\n      var r = cur || {B:4, T:8192, s:2, kv:4, total:16, free:8, tmax:24576, perSeq:1};\n      return {\n        values: {B:r.B, T:r.T, s:r.s},\n        visible_step: null,\n        observation: {\n          summary: 'B＝' + r.B + '、T＝' + r.T + '、s＝' + r.s + '：K/V 缓存 ' + G(r.kv) + '，合计 ' + G(r.total) + '，' + (r.free >= 0 ? '剩余 ' + G(r.free) + '，装得下' : '超出 ' + G(-r.free) + '，装不下') + '。',\n          state: {\n            B: r.B, T: r.T, s: r.s,\n            kv_cache_GiB: r.kv,\n            total_GiB: r.total,\n            headroom_GiB: Math.max(0, r.free),\n            overflow_GiB: Math.max(0, -r.free),\n            fits: r.free >= 0,\n            max_context_tokens: r.tmax,\n            cost_per_extra_sequence_GiB: r.perSeq\n          }\n        }\n      };\n    });\n  }\n  if (P && P.registerStateRestorer){\n    P.registerStateRestorer(function(saved){\n      var p = saved && saved.values && saved.values.page;\n      if (p){\n        if (typeof p.B === 'number') bR.value = String(Math.min(16, Math.max(1, Math.round(p.B))));\n        if (typeof p.T === 'number') tR.value = String(Math.min(T_CAP, Math.max(0, Math.round(p.T))));\n        if (typeof p.s === 'number'){\n          var sv = Math.round(p.s);\n          sR.value = (sv === 1 || sv === 2 || sv === 4) ? String(sv) : '2';\n        }\n      }\n      render();\n    });\n  }\n  if (P && P.registerActionHandler){\n    P.registerActionHandler(async function(action){\n      if (!action || action.kind !== 'set_parameters') return;\n      var v = action.values || action.parameters || {};\n      if (typeof v.B === 'number') bR.value = String(Math.min(16, Math.max(1, Math.round(v.B))));\n      if (typeof v.T === 'number') tR.value = String(Math.min(T_CAP, Math.max(0, Math.round(v.T))));\n      if (typeof v.s === 'number'){\n        var sv = Math.round(v.s);\n        if (sv === 1 || sv === 2 || sv === 4) sR.value = String(sv);\n      }\n      render();\n    });\n  }\n\n  render();\n})();\n</script>\n</body>\n</html>"
