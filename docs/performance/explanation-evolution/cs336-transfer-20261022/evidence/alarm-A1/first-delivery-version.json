    "assumptions": [],
    "state_contract": {
      "d_percent": "检出率 d，单位百分比，范围 0 到 100；分母是有缺陷的零件，指有缺陷件中报警的比例",
      "f_percent": "误报率 f，单位百分比，范围 0 到 10，允许一位小数；分母是无缺陷的零件，指无缺陷件中报警的比例",
      "p_percent": "缺陷率 p，单位百分比，范围 0 到 10，允许一位小数；分母是本批全部 10000 件，有缺陷件 = 10000 × p / 100"
    },
    "initial_state": {
      "d_percent": 95,
      "f_percent": 5,
      "p_percent": 1
    }
