    "content_files": {
      "index.html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>u 被用两次：反向传播为什么把两份回传相加</title>\n<style>\n:root{\n  --canvas:#faf8f4; --ink:#1c1b19; --surface:#ffffff; --line:#d9d4cb;\n  --accent:#0f6b66; --local:#a8631b; --muted:#77726a;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{\n  margin:0;background:var(--canvas);color:var(--ink);\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans SC\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;\n  font-size:16px;line-height:1.78;\n}\n.wrap{max-width:820px;margin:0 auto;padding:26px 16px 76px}\nh1{font-size:clamp(21px,5vw,29px);line-height:1.42;margin:0 0 12px;letter-spacing:-0.01em}\nh2{font-size:clamp(17px,3.6vw,20px);margin:36px 0 10px;line-height:1.55}\nh3{font-size:16px;margin:0 0 6px;line-height:1.5}\np{margin:0 0 12px}\nul{margin:0 0 12px;padding-left:1.2em}\nli{margin:0 0 7px}\n.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace;font-variant-numeric:tabular-nums}\n.lede{color:#3b3833;font-size:17px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;margin:20px 0 8px}\n.status{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}\n.pill{display:inline-flex;align-items:center;min-height:32px;padding:2px 12px;border-radius:999px;background:#f4f1ea;border:1px solid var(--line);font-size:14px;font-variant-numeric:tabular-nums}\n.pill.step{background:#eaf5f3;border-color:#b8d8d5;color:#0b4f4b}\n.srow{display:grid;grid-template-columns:22px minmax(0,1fr) 58px;gap:10px;align-items:center}\n.srow label{font-size:16px;font-weight:600;text-align:center}\n.srow output{font-size:15px;text-align:right;color:var(--accent);font-weight:600;font-variant-numeric:tabular-nums}\ninput[type=\"range\"]{width:100%;height:44px;margin:0;accent-color:#0f6b66;background:transparent;display:block}\n.presets{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 2px}\n.presets button{\n  min-height:44px;min-width:44px;padding:8px 12px;border-radius:10px;\n  border:1px solid var(--line);background:#fdfcf9;color:var(--ink);\n  font:inherit;font-size:14px;line-height:1.3;cursor:pointer;\n}\n.presets button:active{background:#f0ece3}\n.graphwrap{max-width:420px;margin:10px auto 4px}\n#graph{display:block;width:100%;height:auto}\n.legend{font-size:13px;color:var(--muted);text-align:center;margin:2px 0 14px;line-height:1.65}\n.legend .sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin:0 4px 0 10px;vertical-align:baseline}\n.legend .sw.g{background:#8b857a}\n.legend .sw.l{background:var(--local)}\n.legend .sw.a{background:var(--accent)}\n.stepnav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 12px}\n.stepnav button{\n  min-height:44px;min-width:44px;padding:8px 14px;border-radius:10px;\n  border:1px solid var(--line);background:#fdfcf9;color:var(--ink);\n  font:inherit;font-size:15px;cursor:pointer;\n}\n.stepnav button.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n.stepnav button[disabled]{opacity:.42;cursor:default}\n.stepcard{border:1px solid var(--line);border-radius:12px;padding:14px;background:#fcfbf8}\n.tag{display:inline-block;font-size:12.5px;padding:2px 9px;border-radius:999px;border:1px solid var(--line);margin-bottom:8px;background:#f2efe8;color:#4b4a46}\n.tag.loc{color:var(--local);border-color:#e2c9a8;background:#fbf3e8}\n.tag.grad{color:var(--accent);border-color:#b8d8d5;background:#eaf5f3}\n.tag.join{color:#fff;background:var(--accent);border-color:var(--accent)}\n.stepcard p{margin:0 0 10px}\n.formula{\n  margin:0;background:#fff;border:1px dashed var(--line);border-radius:8px;\n  padding:10px;font-size:14.5px;overflow-x:auto;white-space:nowrap;\n}\n.ledgers{display:grid;grid-template-columns:minmax(0,1fr);gap:12px;margin-top:14px}\n@media (min-width:660px){.ledgers{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}\n.ledger{border:1px solid var(--line);border-radius:12px;padding:12px;background:#fcfbf8;min-width:0}\n.ledger h4{margin:0 0 8px;font-size:14.5px;letter-spacing:.01em}\n.ledger .lnote{margin:8px 0 0;font-size:12.5px;color:var(--muted);line-height:1.6}\n.lrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start;padding:7px 0;border-top:1px dashed #e6e1d8}\n.lname{font-size:13.5px;color:#3b3833}\n.lexp{font-size:12.5px;color:#8d877c;word-break:break-word}\n.lval{font-size:16px;font-weight:600;color:#b6afa3;padding-top:2px}\n.lrow.on .lname{color:var(--ink)}\n.lrow.on .lexp{color:var(--local)}\n.lrow.on .lval{color:var(--local)}\n.ltotal{display:grid;grid-template-columns:minmax(0,1fr);gap:2px;padding:10px 0 0;border-top:1px solid var(--line);margin-top:2px}\n.ltotal span{font-size:12.5px;color:var(--muted)}\n.ltotal strong{font-size:16px;color:#b6afa3;font-weight:600}\n.ltotal.on strong{color:var(--accent)}\n.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;margin:16px 0}\n.card p{margin:0 0 10px}\n.card p:last-child{margin-bottom:0}\n.card .small{font-size:14px;overflow-x:auto;white-space:nowrap}\n.verdict{font-size:14px;color:#2a2a28;background:#eaf5f3;border-radius:8px;padding:10px;line-height:1.6}\n.omrow{font-size:14.5px;line-height:1.7}\n.omrow b{color:var(--accent)}\n.note{font-size:13.5px;color:var(--muted);line-height:1.7}\n/* --- 计算图 --- */\n.node .nbox{fill:#fff;stroke:#d8d3ca;stroke-width:1.5}\n.node.on .nbox{stroke:#b3cbc8}\n.node.active .nbox{stroke:var(--accent);stroke-width:2.6}\n.node .nname{font-size:12.5px;fill:#8b857a;text-anchor:middle;letter-spacing:.06em}\n.node .nvalue{font-size:17px;fill:#b6afa3;text-anchor:middle;font-weight:600}\n.node.on .nvalue{fill:var(--ink)}\n.node .ngrad{font-size:10.5px;fill:#c3bdb1;text-anchor:middle}\n.node .ngrad.on{fill:var(--accent)}\n.edge{fill:none;stroke:#cfc9bd;stroke-width:1.8}\n.edge.lit{stroke:#84a9a5;stroke-width:2.6}\n.eback{fill:none;stroke:var(--accent);stroke-width:3.2;visibility:hidden}\n.eback.on{visibility:visible}\n.ebadge{font-size:12px;fill:var(--local);text-anchor:middle;font-weight:600;visibility:hidden}\n.ebadge.on{visibility:visible}\n</style>\n</head>\n<body>\n<main class=\"wrap\">\n\n<h1>一个中间量被用两次，反向传播怎么不漏算</h1>\n<p class=\"lede\">只用一个小模型：u = x·y，v = u + x，L = v² + 3u。u 是同一个计算结果，被 v 和输出里的 3u 各用一次；x 也进了两个地方。下面先用一张可操作的图把数值、边的局部导数、最终的梯度分清楚，再解释两份回传为什么相加、在哪里相加。</p>\n\n<section class=\"panel\" aria-label=\"交互计算图\">\n  <div class=\"status\">\n    <span class=\"pill\" id=\"statusInputs\">x = 2　y = 3</span>\n    <span class=\"pill step\" id=\"statusStep\">第 13 / 13 步</span>\n  </div>\n\n  <div class=\"srow\">\n    <label for=\"sx\">x</label>\n    <input id=\"sx\" type=\"range\" min=\"-3\" max=\"3\" step=\"0.5\" value=\"2\">\n    <output id=\"ox\" for=\"sx\">2</output>\n  </div>\n  <div class=\"srow\">\n    <label for=\"sy\">y</label>\n    <input id=\"sy\" type=\"range\" min=\"-3\" max=\"3\" step=\"0.5\" value=\"3\">\n    <output id=\"oy\" for=\"sy\">3</output>\n  </div>\n  <div class=\"presets\">\n    <button type=\"button\" id=\"psDefault\">默认：x=2, y=3</button>\n    <button type=\"button\" id=\"psZero\">v=0：一条贡献为 0</button>\n    <button type=\"button\" id=\"psCancel\">两份抵消</button>\n  </div>\n\n  <div class=\"graphwrap\">\n    <svg id=\"graph\" viewBox=\"0 0 360 500\" role=\"img\" aria-labelledby=\"graphTitle\">\n      <title id=\"graphTitle\">计算图：x 与 y 算出 u，u 与 x 算出 v，v 与 u 算出 L</title>\n      <defs>\n        <marker id=\"ar\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\">\n          <path d=\"M0 0 L10 5 L0 10 z\" fill=\"#c3bdb1\"></path>\n        </marker>\n        <marker id=\"arA\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\">\n          <path d=\"M0 0 L10 5 L0 10 z\" fill=\"#0f6b66\"></path>\n        </marker>\n      </defs>\n      <g id=\"edges\">\n        <path class=\"edge\" id=\"e-y-u\" d=\"M 100 87 L 150 151\" marker-end=\"url(#ar)\"></path>\n        <path class=\"edge\" id=\"e-x-u\" d=\"M 260 87 L 210 151\" marker-end=\"url(#ar)\"></path>\n        <path class=\"edge\" id=\"e-u-v\" d=\"M 180 221 L 180 275\" marker-end=\"url(#ar)\"></path>\n        <path class=\"edge\" id=\"e-v-L\" d=\"M 180 345 L 180 399\" marker-end=\"url(#ar)\"></path>\n        <path class=\"edge\" id=\"e-x-v\" d=\"M 320 87 C 348 160 348 250 236 300\" marker-end=\"url(#ar)\"></path>\n        <path class=\"edge\" id=\"e-u-L\" d=\"M 123 205 C 54 262 54 356 123 414\" marker-end=\"url(#ar)\"></path>\n        <path class=\"eback\" id=\"eb-y-u\" d=\"M 150 151 L 100 87\" marker-end=\"url(#arA)\"></path>\n        <path class=\"eback\" id=\"eb-x-u\" d=\"M 210 151 L 260 87\" marker-end=\"url(#arA)\"></path>\n        <path class=\"eback\" id=\"eb-u-v\" d=\"M 180 275 L 180 221\" marker-end=\"url(#arA)\"></path>\n        <path class=\"eback\" id=\"eb-v-L\" d=\"M 180 399 L 180 345\" marker-end=\"url(#arA)\"></path>\n        <path class=\"eback\" id=\"eb-x-v\" d=\"M 236 300 C 348 250 348 160 320 87\" marker-end=\"url(#arA)\"></path>\n        <path class=\"eback\" id=\"eb-u-L\" d=\"M 123 414 C 54 356 54 262 123 205\" marker-end=\"url(#arA)\"></path>\n      </g>\n      <g id=\"nodes\">\n        <g class=\"node\" id=\"n-y\" transform=\"translate(74,52)\">\n          <rect class=\"nbox\" x=\"-56\" y=\"-35\" width=\"112\" height=\"70\" rx=\"12\"></rect>\n          <text class=\"nname\" y=\"-15\">y</text>\n          <text class=\"nvalue\" y=\"7\">3</text>\n          <text class=\"ngrad\" y=\"27\">∂L/∂y = ?</text>\n        </g>\n        <g class=\"node\" id=\"n-x\" transform=\"translate(286,52)\">\n          <rect class=\"nbox\" x=\"-56\" y=\"-35\" width=\"112\" height=\"70\" rx=\"12\"></rect>\n          <text class=\"nname\" y=\"-15\">x</text>\n          <text class=\"nvalue\" y=\"7\">2</text>\n          <text class=\"ngrad\" y=\"27\">∂L/∂x = ?</text>\n        </g>\n        <g class=\"node\" id=\"n-u\" transform=\"translate(180,186)\">\n          <rect class=\"nbox\" x=\"-56\" y=\"-35\" width=\"112\" height=\"70\" rx=\"12\"></rect>\n          <text class=\"nname\" y=\"-15\">u</text>\n          <text class=\"nvalue\" y=\"7\">?</text>\n          <text class=\"ngrad\" y=\"27\">∂L/∂u = ?</text>\n        </g>\n        <g class=\"node\" id=\"n-v\" transform=\"translate(180,310)\">\n          <rect class=\"nbox\" x=\"-56\" y=\"-35\" width=\"112\" height=\"70\" rx=\"12\"></rect>\n          <text class=\"nname\" y=\"-15\">v</text>\n          <text class=\"nvalue\" y=\"7\">?</text>\n          <text class=\"ngrad\" y=\"27\">∂L/∂v = ?</text>\n        </g>\n        <g class=\"node\" id=\"n-L\" transform=\"translate(180,434)\">\n          <rect class=\"nbox\" x=\"-56\" y=\"-35\" width=\"112\" height=\"70\" rx=\"12\"></rect>\n          <text class=\"nname\" y=\"-15\">L</text>\n          <text class=\"nvalue\" y=\"7\">?</text>\n          <text class=\"ngrad\" y=\"27\">∂L/∂L = ?</text>\n        </g>\n      </g>\n      <g id=\"badges\">\n        <text class=\"ebadge\" id=\"bd-y-u\" x=\"106\" y=\"124\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×3</text>\n        <text class=\"ebadge\" id=\"bd-x-u\" x=\"256\" y=\"124\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×3</text>\n        <text class=\"ebadge\" id=\"bd-u-v\" x=\"218\" y=\"246\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×1</text>\n        <text class=\"ebadge\" id=\"bd-x-v\" x=\"316\" y=\"158\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×1</text>\n        <text class=\"ebadge\" id=\"bd-v-L\" x=\"218\" y=\"372\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×16</text>\n        <text class=\"ebadge\" id=\"bd-u-L\" x=\"48\" y=\"303\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"4\">×3</text>\n      </g>\n    </svg>\n  </div>\n  <p class=\"legend\">\n    <span class=\"sw g\"></span>节点里的前向数值<span class=\"sw l\"></span>边上的 ×n = 这条边的局部导数（下游对上游的偏导）<span class=\"sw a\"></span>∂L/∂· = 对 L 的梯度\n  </p>\n\n  <div class=\"stepnav\">\n    <button type=\"button\" id=\"prev\">上一步</button>\n    <button type=\"button\" id=\"next\" class=\"primary\">下一步</button>\n    <button type=\"button\" id=\"replay\">从头重放</button>\n  </div>\n\n  <div class=\"stepcard\">\n    <span class=\"tag\" id=\"stepTag\">梯度</span>\n    <h3 id=\"stepTitle\">y 只有一条路</h3>\n    <p id=\"stepBody\">y 只出现在 u = xy 里，所以只有一份贡献。</p>\n    <p class=\"formula mono\" id=\"stepFormula\">∂L/∂y = 38</p>\n  </div>\n\n  <div class=\"ledgers\">\n    <div class=\"ledger\">\n      <h4>u 的账本 · 两条路</h4>\n      <div id=\"ledgerU\"></div>\n      <p class=\"lnote\">往 x、y 传的是合计；两条单独的贡献不再分头传。</p>\n    </div>\n    <div class=\"ledger\">\n      <h4>x 的账本 · 两条路</h4>\n      <div id=\"ledgerX\"></div>\n      <p class=\"lnote\">x 是输入，合计就是 L 对它的最终梯度。</p>\n    </div>\n  </div>\n</section>\n\n<div class=\"card\">\n  <h3>独立核对：把 L 直接展开成 x、y 的式子</h3>\n  <p class=\"mono small\">L = (xy + x)² + 3xy = x²y² + 2x²y + x² + 3xy</p>\n  <p class=\"mono small\">∂L/∂x = 2xy² + 4xy + 2x + 3y</p>\n  <p class=\"mono small\" id=\"ckX\"></p>\n  <p class=\"mono small\">∂L/∂y = 2x²y + 2x² + 3x</p>\n  <p class=\"mono small\" id=\"ckY\"></p>\n  <p class=\"verdict\" id=\"ckVerdict\"></p>\n</div>\n\n<div class=\"card\">\n  <h3>漏掉一条会得到什么</h3>\n  <p class=\"omrow\">正确：<span class=\"mono\" id=\"omGood\"></span></p>\n  <p class=\"omrow\"><b>漏掉 u 的「3u 项」那份：</b><span class=\"mono\" id=\"omA\"></span></p>\n  <p class=\"omrow\"><b>漏掉 x「直接进 v」那份：</b><span class=\"mono\" id=\"omB\"></span></p>\n  <p class=\"note\" id=\"omNote\"></p>\n</div>\n\n<h2>这张图里，谁被用了两次</h2>\n<p>模型只有三个式子：u = x·y，v = u + x，L = v² + 3u。画成图以后，一条边表示\"谁用到谁\"。其中有两条边一步跨过中间量：右边那条弧线从 x 直接连到 v，左边那条弧线从 u 直接连到 L。</p>\n<p>数出边就能数出回传的份数：u 有两条出边（进 v、进 L 的 3u 项），所以 u 会收到两份贡献；x 有两条出边（进 u、直接进 v），同样两份；y 只有一条出边（进 u），只有一份。反向传播里\"被用两次就要相加\"的来源就在这里。</p>\n\n<h2>前向：三个数各算一次</h2>\n<p>默认 x = 2、y = 3：u = 2 × 3 = 6；v = 6 + 2 = 8；L = 8² + 3 × 6 = 64 + 18 = 82。每个节点只做一次算术，用的是上游已经算好的数值。图上灰色数字就是这三个值加上两个输入。</p>\n\n<h2>反向：每条边乘一个局部导数</h2>\n<p>反向要回答的是\"L 对某个量有多敏感\"。做法是从 L 往回走，每经过一条边就乘上这条边的局部导数，也就是这条边下游对上游的偏导。每个局部导数只看一条边：</p>\n<ul>\n<li>v→L：∂L/∂v = 2v；求它时把 3u 当作常数。</li>\n<li>u→L：3u 这一项给出常数 3；求它时把 v² 当作常数。</li>\n<li>u→v：∂v/∂u = 1。</li>\n<li>u→x：∂u/∂x = y；求它时把 y 当作常数。</li>\n<li>v→x：∂v/∂x = 1。</li>\n<li>u→y：∂u/∂y = x；求它时把 x 当作常数。</li>\n</ul>\n<p>默认输入下依次得到：∂L/∂L = 1，∂L/∂v = 1 × 16 = 16，∂L/∂u = 16 + 3 = 19，∂L/∂x = 19 × 3 + 16 × 1 = 73，∂L/∂y = 19 × 2 = 38。</p>\n\n<h2>顺序：先算靠近 L 的，汇合点要等齐</h2>\n<p>反向的先后由依赖关系决定：先 v→L，再 u→v 与 u→L，然后才轮到 u→x、v→x、u→y。u 在中间，它必须先收齐所有出边回传的贡献，才能把总数往 x、y 送。至于相邻的两条边谁先谁后，比如 u→x 与 v→x，顺序可以互换，结果不变。</p>\n<p>如果把顺序弄反：u 一收到第一份 16 就往上游传，传出去的只是 2v；此时真正该传的是 2v + 3 = 19。漏账发生的具体位置就是这里——汇合点还没收齐就提前转发。</p>\n\n<h2>为什么两份要相加</h2>\n<p>把 u 当成可以单独变动的量，这正是偏导 ∂L/∂u 的含义。假设 u 增加一个很小的量 ε，由于 v = u + x，v 也跟着增加 ε：</p>\n<ul>\n<li>3u 这一项增加 3ε；</li>\n<li>v² 增加约 2v·ε，默认 v = 8 时是 16ε；</li>\n<li>L 一共增加约 19ε，除以 ε 得 19，也就是 2v + 3。</li>\n</ul>\n<p>两处变化是同时发生的，所以 u 对 L 的灵敏度是两条路之和。取 ε = 0.01 试一遍：3u 从 18 变成 18.03，v 从 8 变成 8.01，v² 从 64 变成 64.1601，L 从 82 变成 82.1901，多了 0.1901，约等于 19 × 0.01。</p>\n\n<h2>漏掉一条，得到的是错的输入梯度</h2>\n<p>默认输入下正确的 ∂L/∂x 是 73。若 u 处只算了 2v = 16，∂L/∂x 就变成 16 × 3 + 16 = 64，少了 9；而 9 = 3 × y，正是被漏掉的那份 3 乘上 ∂u/∂x。若漏掉的是 x→v 这条直接边，∂L/∂x 就变成 19 × 3 = 57，少了 16，也就是 2v。</p>\n<p>两种情况都会让梯度与展开求导的结果对不上，所以漏账可以当场查出来。有一个特例要留意：y = 0 时 3·y = 0，第一种漏算在 ∂L/∂x 上恰好显示不出差别，但 ∂L/∂u 已经少了 3，∂L/∂y 也跟着错 3x。</p>\n\n<h2>零贡献、负贡献、互相抵消</h2>\n<ul>\n<li>某条贡献恰好为 0：取 x = −2、y = −1，得 u = 2、v = 0，于是 ∂L/∂v = 2v = 0。经 v 的那份贡献是 0，3u 那份仍是 3，所以 ∂L/∂u = 3，∂L/∂x = 3 × (−1) + 0 × 1 = −3。这份 0 照样写在账本里。</li>\n<li>两份互相抵消：取 x = 3、y = −1.5，得 u = −4.5、v = −1.5，∂L/∂v = −3，∂L/∂u = −3 + 3 = 0。u 的梯度是 0，但 ∂L/∂x = 0 × (−1.5) + (−3) × 1 = −3，不为 0。相加得 0 与\"这条路不存在\"是两件事。</li>\n<li>负数只表示方向：局部导数为负，说明这个量增大时 L 减小，乘法照做，符号照留。</li>\n</ul>\n\n<h2>用展开求导再核对一次</h2>\n<p>把 L 写成 x、y 的式子，不经过图和局部导数：</p>\n<p class=\"mono\">L = (xy + x)² + 3xy = x²y² + 2x²y + x² + 3xy</p>\n<p class=\"mono\">∂L/∂x = 2xy² + 4xy + 2x + 3y</p>\n<p class=\"mono\">∂L/∂y = 2x²y + 2x² + 3x</p>\n<p>默认 x = 2、y = 3 时，∂L/∂x = 36 + 24 + 4 + 9 = 73，∂L/∂y = 24 + 8 + 6 = 38，与图上一致。</p>\n<p>逐项还能和两条路对上：经由 u 的那份是 (2v + 3)·y = 2xy² + 2xy + 3y，直接进 v 的那份是 2v·1 = 2xy + 2x，两项相加得 2xy² + 4xy + 2x + 3y。展开式里的 4xy，正是两条路各出 2xy 合起来的。</p>\n\n<h2>一句话带走</h2>\n<p>一个量被 k 处使用，反向时就有 k 份贡献，收齐后相加，再把和往上游传；漏掉一份，输入梯度就正好少那一份乘上该边的局部导数。这份页面的规则只针对这一个小图和标量实数。</p>\n<p class=\"note\">正文里的数字都是默认 x = 2、y = 3 算出来的；改滑块后，交互区与两张核对卡会同步重算。</p>\n\n</main>\n\n<script>\n(function(){\n  'use strict';\n  var MAXSTEP = 12;\n  var state = { x: 2, y: 3, step: MAXSTEP };\n\n  function stepClamp(v){\n    if (typeof v !== 'number' || isNaN(v)) return MAXSTEP;\n    return Math.max(0, Math.min(MAXSTEP, Math.round(v)));\n  }\n  function clamp(v){\n    if (typeof v !== 'number' || isNaN(v)) return 0;\n    v = Math.max(-3, Math.min(3, v));\n    return Math.round(v * 2) / 2;\n  }\n  function f(n){\n    if (typeof n !== 'number' || isNaN(n)) return '?';\n    var r = Math.round(n * 10000) / 10000;\n    if (r === 0) r = 0;\n    return String(r).replace('-', '\\u2212');\n  }\n  function par(n){ return n < 0 ? '(' + f(n) + ')' : f(n); }\n  function terms(a){\n    var s = f(a[0]);\n    for (var i = 1; i < a.length; i++){\n      s += (a[i] < 0 ? ' \\u2212 ' + f(-a[i]) : ' + ' + f(a[i]));\n    }\n    return s;\n  }\n\n  function calc(x, y){\n    var u = x * y, v = u + x, L = v * v + 3 * u;\n    var gv = 2 * v, gu = 2 * v + 3;\n    var gxU = gu * y, gxD = gv;\n    return {\n      x: x, y: y, u: u, v: v, L: L,\n      gv: gv, gu: gu, gxU: gxU, gxD: gxD, gx: gxU + gxD, gy: gu * x,\n      dxE: 2 * x * y * y + 4 * x * y + 2 * x + 3 * y,\n      dyE: 2 * x * x * y + 2 * x * x + 3 * x\n    };\n  }\n\n  var STEPS = [\n    { tag: '输入', cls: '', title: '读入 x 和 y',\n      body: function(c){ return '这次用 x = ' + f(c.x) + '、y = ' + f(c.y) + '。图上后面每个数字都由这一对输入决定：拖动滑块换一组输入，全部重算。'; },\n      formula: function(c){ return 'x = ' + f(c.x) + '　　y = ' + f(c.y); } },\n\n    { tag: '前向值', cls: '', title: 'u = x · y',\n      body: function(c){ return '把 x 和 y 相乘，得到中间量 u。这个 u 会被用两次：一次进入 v，一次直接进入 L 的 3u 项。'; },\n      formula: function(c){ return 'u = ' + f(c.x) + ' × ' + f(c.y) + ' = ' + f(c.u); } },\n\n    { tag: '前向值', cls: '', title: 'v = u + x',\n      body: function(c){ return 'v 既用到 u，也直接用 x。x 因此有两条路通向 L：经过 u 再进 v，以及直接进 v。'; },\n      formula: function(c){ return 'v = ' + f(c.u) + ' + ' + f(c.x) + ' = ' + f(c.v); } },\n\n    { tag: '前向值', cls: '', title: 'L = v² + 3u',\n      body: function(c){ return '输出 L 用了 v 的平方，也直接用了 u。到这里，u 的两条去向都出现在图上了。'; },\n      formula: function(c){ return 'L = ' + f(c.v) + '² + 3 × ' + f(c.u) + ' = ' + f(c.v * c.v) + ' + ' + f(3 * c.u) + ' = ' + f(c.L); } },\n\n    { tag: '梯度', cls: 'grad', title: '反向起点：∂L/∂L = 1',\n      body: function(c){ return '反向传播从输出开始。L 对自身的变化率是 1，后面每一份贡献都从这 1 乘出来。'; },\n      formula: function(c){ return '∂L/∂L = 1'; } },\n\n    { tag: '局部导数 → 梯度', cls: 'loc', title: '边 v→L：局部导数 2v',\n      body: function(c){ return 'v 在 L 里只出现在 v² 中，所以 v 单独变一点，这一项的变化率是 2v。用上游的 1 乘它，得到 v 的梯度。'; },\n      formula: function(c){ return '∂L/∂v = 1 × 2v = 1 × ' + f(2 * c.v) + ' = ' + f(c.gv); } },\n\n    { tag: '局部导数 → u 的账本', cls: 'loc', title: '边 u→L：3u 这一项的局部导数是 3',\n      body: function(c){ return 'u 还直接出现在 3u 里。这条路不经过 v，单独给出常数 3。先把它记到 u 的账本上，暂时别汇总。'; },\n      formula: function(c){ return '1 × 3 = 3　→　u 的第 1 条贡献'; } },\n\n    { tag: '局部导数 → u 的账本', cls: 'loc', title: '边 u→v：局部导数 1',\n      body: function(c){ return 'v = u + x 对 u 的偏导是 1。用 v 的梯度乘 1，这是绕经 v 回来的那一份。'; },\n      formula: function(c){ return '∂L/∂v × ∂v/∂u = ' + f(c.gv) + ' × 1 = ' + f(c.gv) + '　→　u 的第 2 条贡献'; } },\n\n    { tag: '梯度（汇合）', cls: 'join', title: 'u 处汇合：两份相加',\n      body: function(c){ return 'u 的两条去向都回来了，这时才相加。理由是：u 动一点，L 会同时从 v² 和 3u 两处变化，两处变化都属于 ∂L/∂u。收齐之后，这个总数才能继续往 x、y 传。'; },\n      formula: function(c){ return '∂L/∂u = ' + f(c.gv) + ' + 3 = ' + f(c.gu) + '　（也就是 2v + 3）'; } },\n\n    { tag: '局部导数 → x 的账本', cls: 'loc', title: '边 u→x：局部导数 y',\n      body: function(c){ return 'u = xy 对 x 的偏导是 y。用 u 的梯度乘它，得到 x 经由 u 的那一份。'; },\n      formula: function(c){ return '∂L/∂u × ∂u/∂x = ' + f(c.gu) + ' × ' + f(c.y) + ' = ' + f(c.gxU) + '　→　x 的第 1 条贡献'; } },\n\n    { tag: '局部导数 → x 的账本', cls: 'loc', title: '边 v→x：局部导数 1',\n      body: function(c){ return 'x 还直接进了 v，v = u + x 对 x 的偏导是 1。这一份乘的是 v 的梯度，与 u 无关。'; },\n      formula: function(c){ return '∂L/∂v × ∂v/∂x = ' + f(c.gv) + ' × 1 = ' + f(c.gxD) + '　→　x 的第 2 条贡献'; } },\n\n    { tag: '梯度（汇合）', cls: 'join', title: 'x 处汇合：两份相加',\n      body: function(c){ return 'x 的两条路都回来了。到这里反向传播结束，两个输入的梯度都齐了。'; },\n      formula: function(c){ return '∂L/∂x = ' + f(c.gxU) + ' + ' + f(c.gxD) + ' = ' + f(c.gx); } },\n\n    { tag: '梯度', cls: 'grad', title: 'y 只有一条路',\n      body: function(c){ return 'y 只出现在 u = xy 里，所以只有一份贡献，不存在相加。如果 y 也被用在别处，这里就会成为第三次汇合。'; },\n      formula: function(c){ return '∂L/∂y = ∂L/∂u × ∂u/∂y = ' + f(c.gu) + ' × ' + f(c.x) + ' = ' + f(c.gy); } }\n  ];\n\n  var ACTIVE = [\n    ['x','y'], ['u'], ['v'], ['L'], ['L'], ['v'], ['u'], ['u'], ['u'], ['x'], ['x'], ['x'], ['y']\n  ];\n  var HILITE = {\n    0: {}, 1: {'y-u':'fwd','x-u':'fwd'}, 2: {'u-v':'fwd','x-v':'fwd'}, 3: {'v-L':'fwd','u-L':'fwd'},\n    4: {}, 5: {'v-L':'back'}, 6: {'u-L':'back'}, 7: {'u-v':'back'}, 8: {},\n    9: {'x-u':'back'}, 10: {'x-v':'back'}, 11: {}, 12: {'y-u':'back'}\n  };\n  var EDGE_IDS = ['y-u','x-u','u-v','x-v','v-L','u-L'];\n\n  function setNode(id, val, grad, fwdOn, gradOn, active){\n    var g = document.getElementById('n-' + id);\n    if (!g) return;\n    g.setAttribute('class', 'node' + (fwdOn ? ' on' : '') + (active ? ' active' : ''));\n    var v = g.querySelector('.nvalue');\n    if (v) v.textContent = fwdOn ? val : '?';\n    var gr = g.querySelector('.ngrad');\n    if (gr){\n      gr.textContent = grad;\n      gr.setAttribute('class', 'ngrad' + (gradOn ? ' on' : ''));\n    }\n  }\n\n  function ledgerHTML(rows, total){\n    var h = '';\n    for (var i = 0; i < rows.length; i++){\n      var r = rows[i];\n      h += '<div class=\"lrow' + (r.on ? ' on' : '') + '\">'\n        + '<div><div class=\"lname\">' + r.name + '</div><div class=\"lexp mono\">' + r.exp + '</div></div>'\n        + '<div class=\"lval mono\">' + (r.on ? f(r.val) : '—') + '</div>'\n        + '</div>';\n    }\n    h += '<div class=\"ltotal' + (total.on ? ' on' : '') + '\"><span>' + total.label + '</span><strong class=\"mono\">' + total.value + '</strong></div>';\n    return h;\n  }\n\n  function render(){\n    var x = state.x, y = state.y, s = state.step, c = calc(x, y);\n    var byId = function(id){ return document.getElementById(id); };\n\n    var sx = byId('sx'), sy = byId('sy');\n    if (sx) sx.value = String(x);\n    if (sy) sy.value = String(y);\n    if (byId('ox')) byId('ox').textContent = f(x);\n    if (byId('oy')) byId('oy').textContent = f(y);\n    if (byId('statusInputs')) byId('statusInputs').textContent = 'x = ' + f(x) + '　y = ' + f(y);\n    var st = STEPS[s];\n    if (byId('statusStep')) byId('statusStep').textContent = '第 ' + (s + 1) + ' / ' + (MAXSTEP + 1) + ' 步 · ' + st.title;\n\n    var fw = { x: true, y: true, u: s >= 1, v: s >= 2, L: s >= 3 };\n    var gd = { L: s >= 4, v: s >= 5, u: s >= 8, x: s >= 11, y: s >= 12 };\n    var act = ACTIVE[s] || [];\n    setNode('x', f(c.x), '∂L/∂x = ' + (gd.x ? f(c.gx) : '?'), true, gd.x, act.indexOf('x') >= 0);\n    setNode('y', f(c.y), '∂L/∂y = ' + (gd.y ? f(c.gy) : '?'), true, gd.y, act.indexOf('y') >= 0);\n    setNode('u', f(c.u), '∂L/∂u = ' + (gd.u ? f(c.gu) : '?'), fw.u, gd.u, act.indexOf('u') >= 0);\n    setNode('v', f(c.v), '∂L/∂v = ' + (gd.v ? f(c.gv) : '?'), fw.v, gd.v, act.indexOf('v') >= 0);\n    setNode('L', f(c.L), '∂L/∂L = ' + (gd.L ? '1' : '?'), fw.L, gd.L, act.indexOf('L') >= 0);\n\n    var hi = HILITE[s] || {};\n    var BADGE = {\n      'y-u': { min: 12, val: c.x },\n      'x-u': { min: 9, val: c.y },\n      'u-v': { min: 7, val: 1 },\n      'x-v': { min: 10, val: 1 },\n      'v-L': { min: 5, val: 2 * c.v },\n      'u-L': { min: 6, val: 3 }\n    };\n    for (var i = 0; i < EDGE_IDS.length; i++){\n      var id = EDGE_IDS[i];\n      var path = byId('e-' + id), back = byId('eb-' + id), badge = byId('bd-' + id);\n      var mode = hi[id];\n      if (path) path.setAttribute('class', 'edge' + (mode === 'fwd' ? ' lit' : ''));\n      if (back) back.setAttribute('class', 'eback' + (mode === 'back' ? ' on' : ''));\n      if (badge){\n        badge.textContent = '×' + f(BADGE[id].val);\n        badge.setAttribute('class', 'ebadge' + (s >= BADGE[id].min ? ' on' : ''));\n      }\n    }\n\n    if (byId('stepTag')){\n      byId('stepTag').textContent = st.tag;\n      byId('stepTag').setAttribute('class', 'tag ' + st.cls);\n    }\n    if (byId('stepTitle')) byId('stepTitle').textContent = st.title;\n    if (byId('stepBody')) byId('stepBody').textContent = st.body(c);\n    if (byId('stepFormula')) byId('stepFormula').textContent = st.formula(c);\n    if (byId('prev')) byId('prev').disabled = (s === 0);\n    if (byId('next')) byId('next').disabled = (s === MAXSTEP);\n\n    var u1on = s >= 6, u2on = s >= 7, uMissing = (u1on ? 0 : 1) + (u2on ? 0 : 1);\n    if (byId('ledgerU')){\n      byId('ledgerU').innerHTML = ledgerHTML([\n        { name: '① L 里的 3u 项', exp: '1 × ∂(3u)/∂u = 1 × 3', val: 3, on: u1on },\n        { name: '② 经过 v', exp: '∂L/∂v × ∂v/∂u = ' + f(c.gv) + ' × 1', val: c.gv, on: u2on }\n      ], {\n        on: s >= 8,\n        label: s >= 8 ? '合计' : '还差 ' + uMissing + ' 条回传，暂不汇总',\n        value: s >= 8 ? '∂L/∂u = ' + f(c.gv) + ' + 3 = ' + f(c.gu) : '—'\n      });\n    }\n\n    var x1on = s >= 9, x2on = s >= 10, xMissing = (x1on ? 0 : 1) + (x2on ? 0 : 1);\n    if (byId('ledgerX')){\n      byId('ledgerX').innerHTML = ledgerHTML([\n        { name: '① 经由 u', exp: '∂L/∂u × ∂u/∂x = ' + f(c.gu) + ' × ' + f(c.y), val: c.gxU, on: x1on },\n        { name: '② 直接进 v', exp: '∂L/∂v × ∂v/∂x = ' + f(c.gv) + ' × 1', val: c.gxD, on: x2on }\n      ], {\n        on: s >= 11,\n        label: s >= 11 ? '合计' : '还差 ' + xMissing + ' 条回传，暂不汇总',\n        value: s >= 11 ? '∂L/∂x = ' + f(c.gxU) + ' + ' + f(c.gxD) + ' = ' + f(c.gx) : '—'\n      });\n    }\n\n    if (byId('ckX')){\n      byId('ckX').textContent = '= 2·' + par(x) + '·' + par(y) + '² + 4·' + par(x) + '·' + par(y)\n        + ' + 2·' + par(x) + ' + 3·' + par(y) + ' = '\n        + terms([2 * x * y * y, 4 * x * y, 2 * x, 3 * y]) + ' = ' + f(c.dxE);\n    }\n    if (byId('ckY')){\n      byId('ckY').textContent = '= 2·' + par(x) + '²·' + par(y) + ' + 2·' + par(x) + '² + 3·' + par(x) + ' = '\n        + terms([2 * x * x * y, 2 * x * x, 3 * x]) + ' = ' + f(c.dyE);\n    }\n    if (byId('ckVerdict')){\n      var ok = Math.abs(c.gx - c.dxE) < 1e-9 && Math.abs(c.gy - c.dyE) < 1e-9;\n      byId('ckVerdict').textContent = ok\n        ? '图上 ∂L/∂x = ' + f(c.gx) + '，展开得 ' + f(c.dxE) + '；图上 ∂L/∂y = ' + f(c.gy) + '，展开得 ' + f(c.dyE) + '。两边一致。'\n        : '两边不一致：图上 ' + f(c.gx) + ' / ' + f(c.gy) + '，展开 ' + f(c.dxE) + ' / ' + f(c.dyE) + '。';\n    }\n\n    var missU = 2 * c.v;\n    var wrongA = missU * c.y + c.gv;\n    var wrongB = c.gxU;\n    if (byId('omGood')) byId('omGood').textContent = '∂L/∂x = ' + f(c.gu) + ' × ' + f(c.y) + ' + ' + f(c.gv) + ' × 1 = ' + f(c.gx);\n    if (byId('omA')) byId('omA').textContent = '∂L/∂u 只剩 2v = ' + f(missU) + '，于是 ∂L/∂x = ' + f(missU) + ' × ' + f(c.y) + ' + ' + f(c.gv) + ' = ' + f(wrongA) + '，比正确值少 ' + f(c.gx - wrongA) + '（正好是 3·y = 3 × ' + f(c.y) + '）。';\n    if (byId('omB')) byId('omB').textContent = '只用经由 u 的那份：∂L/∂x = ' + f(c.gu) + ' × ' + f(c.y) + ' = ' + f(wrongB) + '，比正确值少 ' + f(c.gx - wrongB) + '（正好是 2v = ' + f(c.gv) + '）。';\n    if (byId('omNote')){\n      byId('omNote').textContent = (c.y === 0)\n        ? '现在 y = 0，∂u/∂x 也是 0，所以第一种漏算在 ∂L/∂x 上恰好差 0；但 ∂L/∂u 已经少了 3，∂L/∂y 也跟着错 3x。'\n        : '展开核对给出的 ' + f(c.dxE) + ' 与这两个漏算值都不相等，所以漏账可以当场查出来。';\n    }\n  }\n\n  function wire(){\n    var byId = function(id){ return document.getElementById(id); };\n    if (byId('sx')) byId('sx').addEventListener('input', function(){ state.x = clamp(parseFloat(this.value)); render(); });\n    if (byId('sy')) byId('sy').addEventListener('input', function(){ state.y = clamp(parseFloat(this.value)); render(); });\n    if (byId('prev')) byId('prev').addEventListener('click', function(){ state.step = Math.max(0, state.step - 1); render(); });\n    if (byId('next')) byId('next').addEventListener('click', function(){ state.step = Math.min(MAXSTEP, state.step + 1); render(); });\n    if (byId('replay')) byId('replay').addEventListener('click', function(){ state.step = 0; render(); });\n\n    var presets = [['psDefault', 2, 3], ['psZero', -2, -1], ['psCancel', 3, -1.5]];\n    for (var i = 0; i < presets.length; i++){\n      (function(p){\n        var el = byId(p[0]);\n        if (el) el.addEventListener('click', function(){\n          state.x = clamp(p[1]);\n          state.y = clamp(p[2]);\n          render();\n        });\n      })(presets[i]);\n    }\n  }\n\n  if (window.presentation){\n    if (window.presentation.initialState){\n      var ini = window.presentation.initialState;\n      if (typeof ini.x === 'number') state.x = clamp(ini.x);\n      if (typeof ini.y === 'number') state.y = clamp(ini.y);\n      if (typeof ini.step === 'number') state.step = stepClamp(ini.step);\n    }\n    if (window.presentation.registerStateReader){\n      window.presentation.registerStateReader(function(){\n        var st = STEPS[state.step];\n        var c = calc(state.x, state.y);\n        return {\n          values: { x: state.x, y: state.y, step: state.step },\n          visible_step: '第 ' + (state.step + 1) + ' 步：' + st.title,\n          observation: {\n            summary: '输入 x = ' + f(state.x) + '、y = ' + f(state.y) + '，当前第 ' + (state.step + 1) + ' 步（' + st.title + '）；图中 ∂L/∂x = ' + f(c.gx) + '，∂L/∂y = ' + f(c.gy) + '，∂L/∂u = ' + f(c.gu) + '。',\n            state: { x: state.x, y: state.y, step: state.step, gu: c.gu, gx: c.gx, gy: c.gy }\n          }\n        };\n      });\n    }\n    if (window.presentation.registerStateRestorer){\n      window.presentation.registerStateRestorer(function(saved){\n        try {\n          var vals = (saved && saved.values) || {};\n          var p = vals.page || vals;\n          if (typeof p.x === 'number') state.x = clamp(p.x);\n          if (typeof p.y === 'number') state.y = clamp(p.y);\n          if (typeof p.step === 'number') state.step = stepClamp(p.step);\n        } catch (e) {}\n        render();\n      });\n    }\n  }\n\n  wire();\n  render();\n})();\n</script>\n</body>\n</html>"
