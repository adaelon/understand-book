+#[test]
+fn presentation_planning_request_rejects_non_boolean_values() {
+    for value in [Value::Null, json!("true")] {
+        let request = json!({
+            "message":"Explain this passage",
+            "presentation_planning_requested":value,
+        });
+        let (_dir, mut state) = setup();
+        let reply = match prepare_agent_chat(&mut state, &request.to_string(), "t1") {
+            Ok(_) => panic!("Non-boolean presentation planning request was accepted"),
+            Err(reply) => reply,
+        };
+        let error: Value = serde_json::from_str(&reply.body).unwrap();
+        assert_eq!(error["error_code"], "RUN_INPUT_INVALID");
+        assert_eq!(error["category"], "validation");
+        let error = crate::run_admission::normalize("workspace", &request).unwrap_err();
+        assert_eq!(error.error_code, "RUN_INPUT_INVALID");
+        assert_eq!(error.category, "validation");
     }
