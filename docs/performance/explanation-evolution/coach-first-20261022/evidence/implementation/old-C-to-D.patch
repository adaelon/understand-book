+#[test]
+fn presentation_planning_request_reaches_run_context() {
+    for (request, expected) in [
+        (json!({"message":"Explain this passage"}), false),
+        (
+            json!({"message":"Explain this passage","presentation_planning_requested":false}),
+            false,
+        ),
+        (
+            json!({"message":"Explain this passage","presentation_planning_requested":true}),
+            true,
+        ),
+    ] {
+        let (_dir, mut state) = setup();
+        let prepared = prepare_agent_chat(&mut state, &request.to_string(), "t1")
+            .unwrap_or_else(|reply| panic!("{}", reply.body));
+        assert_eq!(prepared.presentation_planning_requested, expected);
+        let result = agent_run::execute_model(
+            &Hello,
+            &prepared,
+            Default::default(),
+            None,
+            None,
+            std::time::Instant::now(),
+            |_, _, context| {
+                assert_eq!(context.presentation_planning_requested, expected);
+                Err(ToolError {
+                    error_code: "FIXTURE_STOP".into(),
+                    category: "internal".into(),
+                    message: "Context inspected before any model call".into(),
+                })
+            },
+        );
+        assert_eq!(
+            result.result.as_ref().err().unwrap().error_code,
+            "FIXTURE_STOP"
+        );
+    }
+}
