+#[test]
+fn presentation_planning_normalization_preserves_disabled_request_identity() {
+    let omitted = crate::run_admission::normalize(
+        "workspace",
+        &json!({"message":"Explain this passage"}),
+    )
+    .unwrap();
+    let disabled = crate::run_admission::normalize(
+        "workspace",
+        &json!({"message":"Explain this passage","presentation_planning_requested":false}),
+    )
+    .unwrap();
+    let enabled = crate::run_admission::normalize(
+        "workspace",
+        &json!({"message":"Explain this passage","presentation_planning_requested":true}),
+    )
+    .unwrap();
+    assert_eq!(omitted, disabled);
+    assert_ne!(omitted, enabled);
+    assert_eq!(enabled["presentation_planning_requested"], true);
+}
