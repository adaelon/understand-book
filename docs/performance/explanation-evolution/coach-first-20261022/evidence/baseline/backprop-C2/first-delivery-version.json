      "index.html": "<!DOCTYPE html>\n<html lang='zh-CN'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>一个中间量被用两次：反向传播怎样相加</title>\n<style>\n:root{--canvas:#f5f7fb;--ink:#17202b;--surface:#ffffff;--line:#d7dfea;--accent:#2f6fd0;--muted:#67788a;--warn:#a8620f;--ok:#1a6f47}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--canvas);color:var(--ink);font:16px/1.65 -apple-system,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif}\n.wrap{max-width:1040px;margin:0 auto;padding:14px 14px 64px}\nh1{font-size:clamp(20px,3.2vw,29px);line-height:1.32;margin:4px 0 8px}\n.sub{margin:0 0 4px;color:#48586a;font-size:15px}\nsection{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 14px 16px;margin:14px 0}\nh2{font-size:17px;margin:0 0 10px;line-height:1.4}\nh3{font-size:15px;margin:12px 0 6px}\np{margin:0 0 10px}\nul,ol{margin:0 0 10px;padding-left:22px}\nli{margin:0 0 6px}\nb{color:#0f2c52}\n.eqblk{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13.5px;background:#eff4fb;border:1px solid #dde7f4;border-radius:8px;padding:8px 10px;margin:0 0 10px;overflow-wrap:anywhere;line-height:1.85}\n.controls{display:grid;gap:10px;margin:10px 0 6px}\n@media(min-width:600px){.controls{grid-template-columns:1fr 1fr;gap:18px}}\n.field{display:grid;grid-template-columns:26px minmax(0,1fr) 58px;align-items:center;gap:10px}\n.field label{font-weight:700;font-family:ui-monospace,monospace}\ninput[type=range]{width:100%;min-height:44px;margin:0;accent-color:#2f6fd0}\n.readout{font-family:ui-monospace,monospace;font-size:18px;font-weight:700;text-align:right}\n.btns{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 10px}\nbutton{font:inherit;font-size:14px;min-height:44px;min-width:44px;padding:6px 12px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer}\nbutton.primary{background:var(--accent);border-color:var(--accent);color:#fff}\nbutton:disabled{opacity:.42;cursor:default}\n.presets{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin:0 0 10px}\n.preset{font-size:13px;background:#f2f6fc}\n.preset.on{border-color:var(--accent);color:var(--accent);font-weight:700}\n.status{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0 8px;font-size:14px}\n.chip{border:1px solid var(--line);background:#f2f6fc;border-radius:999px;padding:3px 10px;font-family:ui-monospace,monospace}\n.chip.strong{background:#e6effc;border-color:#bcd4f4;font-weight:700}\n.legend{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 12px;font-size:13px;color:#42546a}\n.legend span{border:1px dashed var(--line);border-radius:8px;padding:2px 8px;background:#fbfcfe}\n.graph{position:relative;display:none;column-gap:100px;row-gap:18px;margin:8px 0 12px}\n@media(min-width:940px){.graph{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(3,minmax(104px,auto))}}\n@media(max-width:939.98px){.deplist{display:block!important}.nodetotals{display:flex!important}}\n#node-y{grid-area:1/1/2/2}\n#node-u{grid-area:2/2/3/3}\n#node-L{grid-area:2/4/3/5}\n#node-x{grid-area:3/1/4/2}\n#node-v{grid-area:3/3/4/4}\n#edges{position:absolute;inset:0;width:100%;height:100%;z-index:0;overflow:visible}\n.node{position:relative;z-index:2;background:#fff;border:2px solid var(--line);border-radius:12px;padding:7px 9px;display:flex;flex-direction:column;gap:1px;min-width:0;width:100%;max-width:112px;justify-self:center}\n.node.active{border-color:var(--accent);box-shadow:0 0 0 3px rgba(47,111,208,.14)}\n.node.merge{border-style:dashed;border-color:#c07a1a}\n.nname{font-weight:800;font-size:15px}\n.nform{font-family:ui-monospace,monospace;font-size:11.5px;color:var(--muted);overflow-wrap:anywhere}\n.nval{font-family:ui-monospace,monospace;font-size:21px;font-weight:800;line-height:1.25;color:#0f2c52}\n.nval.pending{color:#a8b4c2}\n.ngrad{font-family:ui-monospace,monospace;font-size:12px;color:var(--accent);line-height:1.4;overflow-wrap:anywhere}\n.ngrad.pending{color:#a8b4c2}\n.nnote{font-size:11.5px;color:var(--warn);line-height:1.35;min-height:15px}\n.elabel{max-width:88px!important;font-size:10px!important;padding:2px 4px!important;overflow-wrap:anywhere}\n.elabel{position:absolute;z-index:1;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;background:#fff;border:1px solid var(--line);border-radius:8px;padding:2px 6px;font-family:ui-monospace,monospace;font-size:11.5px;line-height:1.35;color:#31445c;text-align:center;pointer-events:none;max-width:180px}\n.elabel .l2{color:var(--accent);font-size:11px}\n.elabel.pending{opacity:.62;border-style:dashed}\n.elabel.back{border-color:var(--accent);box-shadow:0 0 0 2px rgba(47,111,208,.14)}\n.deplist{margin:6px 0 10px}\n@media(min-width:700px){.deplist{display:none}}\n.dep{display:grid;grid-template-columns:66px minmax(0,1fr);gap:2px 10px;border:1px solid var(--line);border-radius:10px;padding:7px 9px;margin:0 0 8px;font-size:13px;background:#fff}\n.dep .e{font-family:ui-monospace,monospace;font-weight:700;color:#0f2c52}\n.dep .l{font-family:ui-monospace,monospace;color:#42546a;overflow-wrap:anywhere}\n.dep .b{font-family:ui-monospace,monospace;color:var(--accent);grid-column:1/3;overflow-wrap:anywhere}\n.dep .b.pending{color:#a8b4c2}\n.nodetotals{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 10px}\n@media(min-width:700px){.nodetotals{display:none}}\n.tot{border:1px solid #bcd4f4;background:#e6effc;border-radius:8px;padding:3px 8px;font-family:ui-monospace,monospace;font-size:12.5px}\n.tot.pending{border-color:var(--line);background:#f2f6fc;color:#a8b4c2}\n.stepPanel{border-left:4px solid var(--accent);background:#f7faff;border-radius:0 10px 10px 0;padding:10px 12px;margin:12px 0}\n.stepPanel h3{margin:0 0 6px;font-size:15px;color:#0f2c52}\n.stepPanel p{margin:0}\n.ledger ol{font-family:ui-monospace,monospace;font-size:13px;line-height:1.75;color:#2b3d52;margin:0;padding-left:22px}\n.ledger li{overflow-wrap:anywhere;margin:0 0 3px}\n.resultBox{display:flex;flex-wrap:wrap;gap:8px 22px;align-items:baseline;border:1px solid #bcd4f4;background:#eaf2fd;border-radius:12px;padding:10px 12px;margin:12px 0 4px}\n.resultBox .item{display:flex;align-items:baseline;gap:8px}\n.resultBox .rl{font-family:ui-monospace,monospace;font-size:13px;color:#3a5578}\n.resultBox .rv{font-family:ui-monospace,monospace;font-size:22px;font-weight:800;color:#0f2c52}\n.resultBox .rnote{flex:1 1 240px;font-size:13px;color:#3a5578;min-width:0}\n.tbl{width:100%;border-collapse:collapse;font-size:13.5px;margin:0 0 10px}\n.tbl th,.tbl td{border:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top;overflow-wrap:anywhere}\n.tbl th{background:#f2f6fc;font-weight:700}\n.tbl td.num{font-family:ui-monospace,monospace}\n@media(max-width:520px){.tbl{font-size:12px}.tbl th,.tbl td{padding:5px 6px}}\n.note{font-size:13px;color:var(--muted)}\n</style>\n</head>\n<body>\n<div class='wrap'>\n\n<h1>一个中间量被用两次，反向传播怎样不漏算</h1>\n<p class='sub'>模型固定为：u = x·y，v = u + x，L = v² + 3u。u 同时供给 v 和 3u；x 同时进入 u 和 v。默认输入 x = 2，y = 3。</p>\n\n<section id='structure'>\n  <h2>这个图里，谁用了谁的结果</h2>\n  <div class='eqblk'>u = x·y　　v = u + x　　L = v² + 3u</div>\n  <p>u 只计算一次，却被两个下游取用：v = u + x 取一次，L 里的 3u 再取一次。x 也出现在两处：它进入 u = x·y，又直接进入 v = u + x。</p>\n  <p>一句话答案：反向传播从 L 出发，按与前面相反的顺序走；走到被多处使用过的量时，先把各条路径回来的贡献加在一起，再用这个总数乘入边的局部导数，继续往上游传。默认输入下最终得到 dL/dx = 73，dL/dy = 38。</p>\n  <h3>图上会出现三种不同的量，先分清</h3>\n  <ul>\n    <li>节点里的大字：这个节点的前向数值，例如 u = 6。</li>\n    <li>边上的小框：这条边的局部导数，例如 ∂u/∂x = y = 3。它只描述这条边两端的两个量之间的关系。</li>\n    <li>节点下面的蓝字：这个节点对 L 的总导数，例如 dL/du = 19。它把从 L 回到这里的所有路径都算进去了。</li>\n  </ul>\n  <p>反向的顺序由依赖决定：一个节点的总导数要用它下游节点的总导数来算，所以先算靠近 L 的节点。u 的总导数需要用到 dL/dv，因此 v 必须先算完，u 才能把两路信息相加。</p>\n</section>\n\n<section id='demo'>\n  <h2>一步一步走：前向求值，反向传导数</h2>\n  <p class='note'>页面默认停在第 11 步，也就是全部算完的状态，可以直接读结果。想看过程，点“从第 0 步开始”，再按“下一步”。拖动 x、y 时所有数值按新输入整体重算，步骤停在原处，下面的状态条始终写着当前输入和当前第几步。</p>\n  <div class='status' id='status' aria-live='polite'></div>\n  <div class='controls'>\n    <div class='field'><label for='xRange'>x</label><input id='xRange' type='range' min='-3' max='3' step='0.5' value='2'><output class='readout' id='xOut'>2</output></div>\n    <div class='field'><label for='yRange'>y</label><input id='yRange' type='range' min='-3' max='3' step='0.5' value='3'><output class='readout' id='yOut'>3</output></div>\n  </div>\n  <div class='btns'>\n    <button id='prevBtn' type='button'>◀ 上一步</button>\n    <button id='nextBtn' type='button' class='primary'>下一步 ▶</button>\n    <button id='startBtn' type='button'>从第 0 步开始</button>\n    <button id='allBtn' type='button'>直接看完整结果</button>\n  </div>\n  <div class='presets'>\n    <span>换一组输入看看：</span>\n    <button type='button' class='preset' data-x='2' data-y='3'>默认 2, 3</button>\n    <button type='button' class='preset' data-x='-1' data-y='2'>负数 -1, 2</button>\n    <button type='button' class='preset' data-x='2' data-y='0'>y = 0：u 支路贡献为 0</button>\n    <button type='button' class='preset' data-x='0' data-y='2'>x = 0：v = 0</button>\n  </div>\n  <div class='legend'>\n    <span>节点大字 = 前向数值</span>\n    <span>边上小框 = 局部导数</span>\n    <span>节点蓝字 = 对 L 的总导数</span>\n    <span>蓝色粗线 = 正在回传</span>\n  </div>\n\n  <div class='graph' id='graph'>\n    <svg id='edges' width='0' height='0' aria-hidden='true'></svg>\n    <div class='node' id='node-y'><div class='nname'>y <span class='nform'>输入</span></div><div class='nval' id='val-y'>3</div><div class='ngrad pending' id='grad-y'>dL/dy = ?</div><div class='nnote' id='note-y'></div></div>\n    <div class='node' id='node-x'><div class='nname'>x <span class='nform'>输入</span></div><div class='nval' id='val-x'>2</div><div class='ngrad pending' id='grad-x'>dL/dx = ?</div><div class='nnote' id='note-x'></div></div>\n    <div class='node' id='node-u'><div class='nname'>u <span class='nform'>= x·y</span></div><div class='nval' id='val-u'>6</div><div class='ngrad pending' id='grad-u'>dL/du = ?</div><div class='nnote' id='note-u'></div></div>\n    <div class='node' id='node-v'><div class='nname'>v <span class='nform'>= u + x</span></div><div class='nval' id='val-v'>8</div><div class='ngrad pending' id='grad-v'>dL/dv = ?</div><div class='nnote' id='note-v'></div></div>\n    <div class='node' id='node-L'><div class='nname'>L <span class='nform'>= v² + 3u</span></div><div class='nval' id='val-L'>82</div><div class='ngrad pending' id='grad-L'>dL/dL = ?</div><div class='nnote' id='note-L'></div></div>\n    <div class='elabel pending' id='lbl-e-xu'></div>\n    <div class='elabel pending' id='lbl-e-yu'></div>\n    <div class='elabel pending' id='lbl-e-uv'></div>\n    <div class='elabel pending' id='lbl-e-xv'></div>\n    <div class='elabel pending' id='lbl-e-vl'></div>\n    <div class='elabel pending' id='lbl-e-ul'></div>\n  </div>\n\n  <div class='deplist' id='deplist'>\n    <p class='note'>屏幕较窄时用这份列表代替图：每行是一条边，左端是上游，右端是下游。</p>\n  </div>\n  <div class='nodetotals' id='nodetotals'></div>\n\n  <div class='stepPanel'><h3 id='stepTitle'>在 x 汇合</h3><p id='stepBody'></p></div>\n\n  <div class='resultBox'>\n    <div class='item'><span class='rl'>dL/dx</span><span class='rv' id='rdx'>?</span></div>\n    <div class='item'><span class='rl'>dL/dy</span><span class='rv' id='rdy'>?</span></div>\n    <div class='item'><span class='rl'>dL/du</span><span class='rv' id='rdu'>?</span></div>\n    <div class='rnote'>dL/du 是中间量 u 的总导数：v 支路与 3u 直接项的贡献相加。dL/dx 再把 u 支路与 v 直连两份加在一起。</div>\n  </div>\n\n  <div class='ledger'><h3>计算记录（按当前输入）</h3><ol id='ledgerList'></ol></div>\n  <p class='note'>还没走到的步骤不会提前写进这份记录，所以它始终只包含已经算过的量。</p>\n</section>\n\n<section id='merge'>\n  <h2>两份信息为什么要相加</h2>\n  <p>拿 u 做一次小实验。假设 u 从当前值增加一个很小的量 Δ，这件事会同时影响 L 的两处：v = u + x 跟着增加 Δ，于是 v² 增加大约 2v·Δ；同时 3u 这一项增加 3Δ。</p>\n  <p>L 的总变化就是这两部分之和，系数加在一起是 2v + 3。所以 L 对 u 的变化率等于 2v + 3：两处效应同时发生，少算任何一项，就漏掉了那部分变化。</p>\n  <div class='eqblk' id='mergeDelta'></div>\n  <p>换成路径的说法：从 L 到 u 有两条路。每条路上的局部导数相乘，得到这条路的贡献；同一个节点收到的所有路径贡献相加，才是这个节点的总导数。</p>\n  <table class='tbl'>\n    <thead><tr><th>从 L 到 u 的路径</th><th>沿路相乘</th><th>贡献</th></tr></thead>\n    <tbody id='mergeRows'></tbody>\n  </table>\n  <p>节点 x 也按同样的规则处理：它从 u 支路收到一份，从 v 直连收到另一份，两份相加才是 dL/dx。</p>\n</section>\n\n<section id='missing'>\n  <h2>漏掉一条贡献，会错在哪里</h2>\n  <p>假设在 x 这个汇合点只把 u 支路的贡献算进去。你会得到一个比正确值小的数，因为 x 还直接进入 v：x 变一点，v 立刻跟着变，这部分完全不经过 u。漏掉的正是这条路径的贡献。</p>\n  <table class='tbl'>\n    <thead><tr><th>做法</th><th>得到的 dL/dx</th><th>与正确值之差</th></tr></thead>\n    <tbody id='missRows'></tbody>\n  </table>\n  <p>判断有没有漏，办法很具体：数一数每个节点有几条出边。u 有两条（通向 v 和 L），x 有两条（通向 u 和 v）。到达这种节点时，必须把各条出边回来的贡献都收齐再相加。只有一条出边的节点（本例的 v）不需要相加。</p>\n  <p id='missNote' class='note'></p>\n</section>\n\n<section id='zero'>\n  <h2>负数和零贡献的意思</h2>\n  <p>局部导数可以是负数。∂u/∂x = y，当 y 为负时它就是负数，u 支路给 x 的贡献也带负号。两份贡献符号相反时会部分抵消，相加的结果可能比每一份的绝对值都小，这正是正确的答案。</p>\n  <p>局部导数为 0 时，这条边回传 0。这只说明这条边此刻没有传递影响：节点自己的总导数仍然可能非零，并继续沿别的边往回走。</p>\n  <p>两个可以直接点开的对照：</p>\n  <ul>\n    <li>取 y = 0：∂u/∂x = y = 0，u 支路对 x 的贡献变成 0；但 dL/du = 2v + 3 仍然非零，并通过 ∂u/∂y = x 继续传给 y。</li>\n    <li>取 x = 0：v = 0，于是 ∂L/∂v = 2v = 0，v 支路对 u 的贡献为 0；u 仍然从 3u 那一项收到 3，所以 dL/du = 3，没有变成 0。</li>\n  </ul>\n  <p>负数可以这样核对（这一句固定用 x = -1、y = 2 说明）：u = -2，v = -3，∂L/∂v = 2v = -6，dL/du = -6 + 3 = -3，dL/dx = -3×2 + (-6) = -12。把 x、y 代入展开式 L = (xy + x)² + 3xy 也得到 -12。</p>\n</section>\n\n<section id='check'>\n  <h2>独立核对：把 L 直接写成 x、y 的函数</h2>\n  <p>把 u 和 v 代进 L = v² + 3u。因为 v = xy + x，所以 L = (xy + x)² + 3xy。这条式子只含 x 和 y，可以直接求偏导，不经过任何回传规则。</p>\n  <div class='eqblk' id='checkX'></div>\n  <div class='eqblk' id='checkY'></div>\n  <p id='checkVerdict'></p>\n  <p>再用中心差分估一次（h = 0.001，纯数值，不参与上面的代数推导）：</p>\n  <div class='eqblk' id='checkNum'></div>\n  <p class='note'>本页只讨论这一个实数模型：某一组输入下的前向值与偏导，不涉及矩阵、网络层或实现性能。</p>\n</section>\n\n</div>\n<script>\n(function(){\n\"use strict\";\nvar $=function(id){return document.getElementById(id);};\nvar TOTAL=11;\nvar state={x:2,y:3,step:11};\nvar TITLES=['读出输入','算 u','算 v','算 L','反向起点','L 的两条出边','传到 v','v 把信息分给两个来源','在 u 汇合','u 的两条入边','传回输入','在 x 汇合'];\nvar ACTIVE={0:['x','y'],1:['u'],2:['v'],3:['L'],4:['L'],5:['L'],6:['v'],7:['v'],8:['u'],9:['u'],10:['u'],11:['x','y']};\n\nfunction fmt(n){var r=Math.round(n*10000)/10000;if(Object.is(r,-0)){r=0;}return String(r);}\nfunction rev(n){return state.step>=n;}\n\nfunction calc(){\n  var x=state.x,y=state.y;\n  var u=x*y,v=u+x,L=v*v+3*u;\n  var dLv=2*v,dLuD=3,gv=dLv,cUu=gv,gu=cUu+dLuD;\n  var cUx=gu*y,cUy=gu*x,cVx=gv;\n  return {x:x,y:y,u:u,v:v,L:L,gL:1,dLv:dLv,dLuD:dLuD,gv:gv,cUu:cUu,gu:gu,cUx:cUx,cUy:cUy,cVx:cVx,gx:cUx+cVx,gy:cUy};\n}\n\nvar EDGES=[\n {id:'e-xu',from:'x',to:'u',revL:9,revB:10,t:0.5,off:24,\n  l1:function(d){return '∂u/∂x = y = '+(rev(9)?fmt(d.y):'?');},\n  l2:function(d){return '回传 '+fmt(d.gu)+'×'+fmt(d.y)+' = '+fmt(d.cUx);}},\n {id:'e-yu',from:'y',to:'u',revL:9,revB:10,t:0.5,off:24,\n  l1:function(d){return '∂u/∂y = x = '+(rev(9)?fmt(d.x):'?');},\n  l2:function(d){return '回传 '+fmt(d.gu)+'×'+fmt(d.x)+' = '+fmt(d.cUy);}},\n {id:'e-uv',from:'u',to:'v',revL:7,revB:7,t:0.44,off:26,\n  l1:function(){return '∂v/∂u = 1';},\n  l2:function(d){return '回传 '+fmt(d.gv)+'×1 = '+fmt(d.cUu);}},\n {id:'e-xv',from:'x',to:'v',revL:7,revB:7,t:0.66,off:24,\n  l1:function(){return '∂v/∂x = 1';},\n  l2:function(d){return '回传 '+fmt(d.gv)+'×1 = '+fmt(d.cVx);}},\n {id:'e-vl',from:'v',to:'L',revL:5,revB:6,t:0.5,off:26,\n  l1:function(d){return '∂L/∂v = 2v = '+(rev(5)?fmt(d.dLv):'?');},\n  l2:function(d){return '回传 1×'+fmt(d.dLv)+' = '+fmt(d.gv);}},\n {id:'e-ul',from:'u',to:'L',revL:5,revB:8,t:0.6,off:26,\n  l1:function(){return '∂L/∂u（3u 项）= '+(rev(5)?'3':'?');},\n  l2:function(){return '回传 1×3 = 3';}}\n];\n\nfunction drawEdges(){\n  var graph=$('graph'),svg=$('edges');\n  if(!graph||svg===null)return;\n  if(graph.offsetParent===null)return;\n  var gr=graph.getBoundingClientRect();\n  var W=Math.round(gr.width),H=Math.round(gr.height);\n  if(W<10||H<10)return;\n  svg.setAttribute('viewBox','0 0 '+W+' '+H);\n  svg.setAttribute('width',W);svg.setAttribute('height',H);\n  var out=['<defs><marker id=\"ah\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5.5\" markerHeight=\"5.5\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#9aa9bb\"></path></marker><marker id=\"ahb\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5.5\" markerHeight=\"5.5\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#2f6fd0\"></path></marker></defs>'];\n  EDGES.forEach(function(e){\n    var a=$('node-'+e.from),b=$('node-'+e.to);\n    if(!a||!b)return;\n    var ra=a.getBoundingClientRect(),rb=b.getBoundingClientRect();\n    var p1x=ra.left-gr.left+ra.width/2,p1y=ra.top-gr.top+ra.height/2;\n    var p2x=rb.left-gr.left+rb.width/2,p2y=rb.top-gr.top+rb.height/2;\n    var dx=p2x-p1x,dy=p2y-p1y,len=Math.sqrt(dx*dx+dy*dy)||1;\n    out.push('<line x1=\"'+p1x+'\" y1=\"'+p1y+'\" x2=\"'+p2x+'\" y2=\"'+p2y+'\" stroke=\"#9aa9bb\" stroke-width=\"2\" marker-end=\"url(#ah)\"></line>');\n    if(rev(e.revB)){\n      var ax=p1x+dx*0.9,ay=p1y+dy*0.9,bx=p1x+dx*0.1,by=p1y+dy*0.1;\n      out.push('<line x1=\"'+ax+'\" y1=\"'+ay+'\" x2=\"'+bx+'\" y2=\"'+by+'\" stroke=\"#2f6fd0\" stroke-width=\"3\" stroke-linecap=\"round\" marker-end=\"url(#ahb)\"></line>');\n    }\n    var lbl=$('lbl-'+e.id);\n    if(lbl){\n      var mx=p1x+dx*e.t,my=p1y+dy*e.t;\n      var nx=-dy/len,ny=dx/len;\n      lbl.style.left=(mx+nx*e.off)+'px';\n      lbl.style.top=(my+ny*e.off)+'px';\n    }\n  });\n  svg.innerHTML=out.join('');\n}\n\nfunction grad(n,on,text,note){\n  var g=$('grad-'+n),nt=$('note-'+n);\n  if(g){g.textContent=text;g.className='ngrad'+(on?'':' pending');}\n  if(nt){nt.textContent=note||'';}\n}\n\nfunction render(){\n  var d=calc(),s=state.step;\n\n  $('xRange').value=String(d.x);$('yRange').value=String(d.y);\n  $('xOut').textContent=fmt(d.x);$('yOut').textContent=fmt(d.y);\n\n  var phase=s<=3?'前向':'反向';\n  $('status').innerHTML='<span class=\"chip strong\">x = '+fmt(d.x)+'</span><span class=\"chip strong\">y = '+fmt(d.y)+'</span><span class=\"chip\">第 '+s+' / '+TOTAL+' 步</span><span class=\"chip\">'+phase+'：'+TITLES[s]+'</span>';\n\n  var shown={x:true,y:true,u:s>=1,v:s>=2,L:s>=3};\n  ['x','y','u','v','L'].forEach(function(n){\n    var el=$('val-'+n);\n    el.textContent=shown[n]?fmt(d[n]):'?';\n    el.className='nval'+(shown[n]?'':' pending');\n    var card=$('node-'+n);\n    card.classList.toggle('active',(ACTIVE[s]||[]).indexOf(n)>=0);\n    card.classList.toggle('merge',(n==='u'&&s>=8)||(n==='x'&&s>=11));\n  });\n\n  grad('L',s>=4,'dL/dL = '+(s>=4?fmt(d.gL):'?'),s>=4?'回传起点':'');\n  grad('v',s>=6,'dL/dv = '+(s>=6?fmt(d.gv):'?'),'');\n  grad('u',s>=8,'dL/du = '+(s>=8?fmt(d.gu):'?'),s>=8?(fmt(d.cUu)+'（来自 v） + 3'):'');\n  grad('x',s>=11,'dL/dx = '+(s>=11?fmt(d.gx):'?'),s>=11?(fmt(d.cUx)+' + '+fmt(d.cVx)):(s>=7?'已收到 '+fmt(d.cVx):''));\n  grad('y',s>=11,'dL/dy = '+(s>=11?fmt(d.gy):'?'),s>=11?'只有一条路径':'');\n\n  EDGES.forEach(function(e){\n    var el=$('lbl-'+e.id);\n    if(!el)return;\n    var html='<span class=\"l1\">'+e.l1(d)+'</span>';\n    if(s>=e.revB){html+='<span class=\"l2\">'+e.l2(d)+'</span>';}\n    el.innerHTML=html;\n    el.className='elabel'+(s>=e.revL?'':' pending')+(s>=e.revB?' back':'');\n  });\n\n  var rows=[\n    {e:'x → u',l:'∂u/∂x = y = '+(s>=9?fmt(d.y):'?'),b:s>=10?('回传 '+fmt(d.gu)+'×'+fmt(d.y)+' = '+fmt(d.cUx)):'待回传',on:s>=10},\n    {e:'y → u',l:'∂u/∂y = x = '+(s>=9?fmt(d.x):'?'),b:s>=10?('回传 '+fmt(d.gu)+'×'+fmt(d.x)+' = '+fmt(d.cUy)):'待回传',on:s>=10},\n    {e:'u → v',l:'∂v/∂u = 1',b:s>=7?('回传 '+fmt(d.gv)+'×1 = '+fmt(d.cUu)):'待回传',on:s>=7},\n    {e:'x → v',l:'∂v/∂x = 1',b:s>=7?('回传 '+fmt(d.gv)+'×1 = '+fmt(d.cVx)):'待回传',on:s>=7},\n    {e:'v → L',l:'∂L/∂v = 2v = '+(s>=5?fmt(d.dLv):'?'),b:s>=6?('回传 1×'+fmt(d.dLv)+' = '+fmt(d.gv)):'待回传',on:s>=6},\n    {e:'u → L',l:'∂L/∂u（3u 项）= '+(s>=5?'3':'?'),b:s>=8?'回传 1×3 = 3':'待回传',on:s>=8}\n  ];\n  var html='';\n  rows.forEach(function(r){\n    html+='<div class=\"dep\"><span class=\"e\">'+r.e+'</span><span class=\"l\">'+r.l+'</span><span class=\"b'+(r.on?'':' pending')+'\">'+r.b+'</span></div>';\n  });\n  $('deplist').innerHTML='<p class=\"note\">屏幕较窄时用这份列表代替图：每行是一条边，左端是上游，右端是下游。</p>'+html;\n\n  var tots=[['dL/dL',s>=4?fmt(d.gL):'?'],['dL/dv',s>=6?fmt(d.gv):'?'],['dL/du',s>=8?fmt(d.gu):'?'],['dL/dx',s>=11?fmt(d.gx):'?'],['dL/dy',s>=11?fmt(d.gy):'?']];\n  var t='';\n  tots.forEach(function(x){\n    t+='<span class=\"tot'+(x[1]==='?'?' pending':'')+'\">'+x[0]+' = '+x[1]+'</span>';\n  });\n  $('nodetotals').innerHTML=t;\n\n  var body=[];\n  body[0]='先把 x = '+fmt(d.x)+'、y = '+fmt(d.y)+' 放进图里。前向的顺序由依赖决定：u 只等 x 和 y；v 还要等 u；L 最后等 v。';\n  body[1]='u = x·y = '+fmt(d.x)+' × '+fmt(d.y)+' = <b>'+fmt(d.u)+'</b>。同一份 u 会被两个下游取用：v = u + x 取一次，L = v² + 3u 里的 3u 再取一次。';\n  body[2]='v = u + x = '+fmt(d.u)+' + '+fmt(d.x)+' = <b>'+fmt(d.v)+'</b>。v 有两个来源：u 和 x。';\n  body[3]='L = v² + 3u = '+fmt(d.v)+'² + 3×'+fmt(d.u)+' = '+fmt(d.v*d.v)+' + '+fmt(3*d.u)+' = <b>'+fmt(d.L)+'</b>。前向结束，五个节点都有数值。';\n  body[4]='反向从 L 开始，先记 dL/dL = 1，这是整条回传的起点。顺序与前向相反：u 的总导数要用到 dL/dv，所以 v 必须先算完，u 才能把两路信息相加。';\n  body[5]='L 沿两条边接收上游的量：经 v² 那条边，局部导数是 ∂L/∂v = 2v = '+fmt(d.dLv)+'；经 3u 那条边，局部导数是 ∂L/∂u = 3。局部导数只描述一条边两端的两个量，它还没有和回传值相乘。';\n  body[6]='v 只通过一条路影响 L，所以 dL/dv = 1 × 2v = <b>'+fmt(d.gv)+'</b>。路径只有一条时，这个节点只收到一份贡献，总导数就等于它。';\n  body[7]='v = u + x 有两条入边，回传值要分给两个上游：沿 u 方向 '+fmt(d.gv)+' × 1 = '+fmt(d.cUu)+'；沿 x 方向 '+fmt(d.gv)+' × 1 = '+fmt(d.cVx)+'。这两份去往不同的汇合点，先分别记下。';\n  body[8]='u 被用了两次，两份信息在这里相加：来自 v 的 '+fmt(d.cUu)+'，加上 3u 直接给 u 的 3，得到 dL/du = '+fmt(d.cUu)+' + 3 = <b>'+fmt(d.gu)+'</b>。到这一步，u 才有可以继续往前传的总导数。';\n  body[9]='u = x·y 的两条入边局部导数：∂u/∂x = y = '+fmt(d.y)+'；∂u/∂y = x = '+fmt(d.x)+'。求偏导时，另一个输入当作常数。';\n  body[10]='用同一个 dL/du = '+fmt(d.gu)+' 分别乘两条边的局部导数：x 从 u 支路得到 '+fmt(d.gu)+' × '+fmt(d.y)+' = '+fmt(d.cUx)+'；y 得到 '+fmt(d.gu)+' × '+fmt(d.x)+' = '+fmt(d.cUy)+'。';\n  body[11]='x 也有两条出边，两份贡献在 x 汇合：u 支路 '+fmt(d.cUx)+' + v 直连 '+fmt(d.cVx)+' = <b>'+fmt(d.gx)+'</b>。y 只有一条路径，所以 dL/dy = '+fmt(d.cUy)+'。';\n  $('stepTitle').textContent=s+' / '+TOTAL+' · '+TITLES[s];\n  $('stepBody').innerHTML=body[s];\n\n  $('rdx').textContent=s>=11?fmt(d.gx):'?';\n  $('rdy').textContent=s>=11?fmt(d.gy):'?';\n  $('rdu').textContent=s>=8?fmt(d.gu):'?';\n\n  var lines=[];\n  lines.push('输入：x = '+fmt(d.x)+'，y = '+fmt(d.y));\n  if(s>=1){lines.push('u = x·y = '+fmt(d.x)+'×'+fmt(d.y)+' = '+fmt(d.u));}\n  if(s>=2){lines.push('v = u + x = '+fmt(d.u)+'+'+fmt(d.x)+' = '+fmt(d.v));}\n  if(s>=3){lines.push('L = v² + 3u = '+fmt(d.v)+'² + 3×'+fmt(d.u)+' = '+fmt(d.L));}\n  if(s>=4){lines.push('种子：dL/dL = 1');}\n  if(s>=5){lines.push('边 v→L 的局部导数 ∂L/∂v = 2v = '+fmt(d.dLv)+'；边 u→L 的局部导数 ∂L/∂u = 3');}\n  if(s>=6){lines.push('dL/dv = 1 × 2v = '+fmt(d.gv));}\n  if(s>=7){lines.push('u→v 回传 '+fmt(d.gv)+'×1 = '+fmt(d.cUu)+'；x→v 回传 '+fmt(d.gv)+'×1 = '+fmt(d.cVx));}\n  if(s>=8){lines.push('dL/du = '+fmt(d.cUu)+'（来自 v）+ 3（来自 3u）= '+fmt(d.gu));}\n  if(s>=9){lines.push('∂u/∂x = y = '+fmt(d.y)+'；∂u/∂y = x = '+fmt(d.x));}\n  if(s>=10){lines.push('x 从 u 支路得到 '+fmt(d.gu)+'×'+fmt(d.y)+' = '+fmt(d.cUx)+'；y 得到 '+fmt(d.gu)+'×'+fmt(d.x)+' = '+fmt(d.cUy));}\n  if(s>=11){lines.push('dL/dx = '+fmt(d.cUx)+' + '+fmt(d.cVx)+' = '+fmt(d.gx)+'；dL/dy = '+fmt(d.cUy));}\n  var lo='';\n  lines.forEach(function(t){lo+='<li>'+t+'</li>';});\n  $('ledgerList').innerHTML=lo;\n\n  var mrow='';\n  mrow+='<tr><td>L ← v ← u</td><td>∂L/∂v × ∂v/∂u = '+fmt(d.dLv)+' × 1 = '+fmt(d.dLv)+'</td><td class=\"num\">'+fmt(d.cUu)+'</td></tr>';\n  mrow+='<tr><td>L ← u（3u 这一项）</td><td>∂L/∂u = '+fmt(d.dLuD)+'</td><td class=\"num\">'+fmt(d.dLuD)+'</td></tr>';\n  mrow+='<tr><td>合计 = 节点 u 的总导数</td><td>'+fmt(d.cUu)+' + '+fmt(d.dLuD)+'</td><td class=\"num\">dL/du = '+fmt(d.gu)+'</td></tr>';\n  $('mergeRows').innerHTML=mrow;\n  $('mergeDelta').innerHTML='设 u 增加 0.01：v 增加 0.01，v² 增加约 2v×0.01 = '+fmt(2*d.v*0.01)+'；3u 增加 3×0.01 = '+fmt(3*0.01)+'；L 共增加约 '+fmt((2*d.v+3)*0.01)+' = (2v + 3)×0.01。';\n\n  var miss='';\n  miss+='<tr><td>只保留 u 支路</td><td class=\"num\">'+fmt(d.cUx)+'</td><td class=\"num\">少 '+fmt(d.cVx)+'</td></tr>';\n  miss+='<tr><td>只保留 v 直连</td><td class=\"num\">'+fmt(d.cVx)+'</td><td class=\"num\">少 '+fmt(d.cUx)+'</td></tr>';\n  miss+='<tr><td>两条都保留（正确）</td><td class=\"num\">'+fmt(d.gx)+'</td><td class=\"num\">—</td></tr>';\n  $('missRows').innerHTML=miss;\n  var zeroNow=(d.cUx===0||d.cVx===0);\n  $('missNote').textContent=zeroNow\n    ? '当前输入下有一条贡献正好是 0（'+(d.cUx===0?'u 支路':'v 直连')+'）。这时漏掉它，数值上不会变，但规则没有变：仍然要把这条边算进来，只是这一项加的是 0。'\n    : '当前输入下两份贡献都是非零的，所以任意漏掉一条，结果都会直接偏掉被漏掉的那一份。';\n\n  var A=d.v,yp1=d.y+1,bx=2*A*yp1,cx=3*d.y,by=2*A*d.x,cy=3*d.x;\n  var gxCheck=bx+cx,gyCheck=by+cy;\n  $('checkX').innerHTML='∂L/∂x = 2(xy + x)(y + 1) + 3y = 2·'+fmt(A)+'·'+fmt(yp1)+' + '+fmt(cx)+' = '+fmt(bx)+' + '+fmt(cx)+' = <b>'+fmt(gxCheck)+'</b>';\n  $('checkY').innerHTML='∂L/∂y = 2(xy + x)·x + 3x = 2·'+fmt(A)+'·'+fmt(d.x)+' + '+fmt(cy)+' = '+fmt(by)+' + '+fmt(cy)+' = <b>'+fmt(gyCheck)+'</b>';\n  var ok=Math.abs(gxCheck-d.gx)<1e-6&&Math.abs(gyCheck-d.gy)<1e-6;\n  $('checkVerdict').innerHTML=ok\n    ? '展开求导得到 ∂L/∂x = '+fmt(gxCheck)+'、∂L/∂y = '+fmt(gyCheck)+'，与上面反向传播的 dL/dx = '+fmt(d.gx)+'、dL/dy = '+fmt(d.gy)+' 相同。两条完全不同的算法给出同一个数。'\n    : '展开求导得到 '+fmt(gxCheck)+' 与 '+fmt(gyCheck)+'，反向传播给出 '+fmt(d.gx)+' 与 '+fmt(d.gy)+'，两者不一致。';\n\n  function Lf(x,y){var t=x*y+x;return t*t+3*x*y;}\n  var h=0.001;\n  var nX=(Lf(d.x+h,d.y)-Lf(d.x-h,d.y))/(2*h);\n  var nY=(Lf(d.x,d.y+h)-Lf(d.x,d.y-h))/(2*h);\n  $('checkNum').innerHTML='dL/dx ≈ '+nX.toFixed(4)+'（差分），解析值 '+fmt(d.gx)+'<br>dL/dy ≈ '+nY.toFixed(4)+'（差分），解析值 '+fmt(d.gy);\n\n  document.querySelectorAll('.preset').forEach(function(b){\n    var on=(parseFloat(b.getAttribute('data-x'))===d.x&&parseFloat(b.getAttribute('data-y'))===d.y);\n    b.classList.toggle('on',on);\n  });\n\n  $('prevBtn').disabled=(s<=0);\n  $('nextBtn').disabled=(s>=TOTAL);\n\n  drawEdges();\n}\n\nfunction setStep(v){state.step=Math.max(0,Math.min(TOTAL,v));render();}\nfunction snap(v){return Math.round(v*2)/2;}\n\n$('nextBtn').onclick=function(){setStep(state.step+1);};\n$('prevBtn').onclick=function(){setStep(state.step-1);};\n$('startBtn').onclick=function(){setStep(0);};\n$('allBtn').onclick=function(){setStep(TOTAL);};\n$('xRange').oninput=function(){state.x=snap(parseFloat(this.value));render();};\n$('yRange').oninput=function(){state.y=snap(parseFloat(this.value));render();};\ndocument.querySelectorAll('.preset').forEach(function(b){\n  b.onclick=function(){\n    state.x=snap(parseFloat(b.getAttribute('data-x')));\n    state.y=snap(parseFloat(b.getAttribute('data-y')));\n    render();\n  };\n});\n\nvar init=(window.presentation&&window.presentation.initialState)||{};\nif(typeof init.x==='number'){state.x=init.x;}\nif(typeof init.y==='number'){state.y=init.y;}\nif(typeof init.step==='number'){state.step=init.step;}\n\nif(window.presentation&&window.presentation.registerStateReader){\n  window.presentation.registerStateReader(function(){\n    return {values:{x:state.x,y:state.y,step:state.step},visible_step:String(state.step)+' / '+TOTAL};\n  });\n}\nif(window.presentation&&window.presentation.registerStateRestorer){\n  window.presentation.registerStateRestorer(function(saved){\n    var v=((saved&&saved.values&&saved.values.page)?saved.values.page:((saved&&saved.values)?saved.values:{}));\n    if(typeof v.x==='number'){state.x=snap(Math.max(-3,Math.min(3,v.x)));}\n    if(typeof v.y==='number'){state.y=snap(Math.max(-3,Math.min(3,v.y)));}\n    if(typeof v.step==='number'){state.step=Math.max(0,Math.min(TOTAL,Math.round(v.step)));}\n    render();\n  });\n}\n\nwindow.addEventListener('resize',function(){drawEdges();});\nwindow.addEventListener('load',function(){render();});\nrender();\n})();\n</script>\n</body>\n</html>"
