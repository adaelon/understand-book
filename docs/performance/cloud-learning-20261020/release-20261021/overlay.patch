+                "admin_cookie":format!("{}={}",crate::auth::COOKIE,f.b),
+                "reader_csrf":crate::auth::csrf(&f.a),"admin_csrf":crate::auth::csrf(&f.b),
+                "text":text,"video":video,"release_id":"cloud-original-fixture",
+                "title":"资料引用与时间片段：原创验收样例"
