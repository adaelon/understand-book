+fn purchase(product: &str, revision: i64, now: i64) -> Purchase {
+    Purchase {
+        product_id: product.into(),
+        product_revision: revision,
+        paid_at: now,
+        channel: "test-fixture".into(),
+        external_ref: None,
+        note: "Fixture payment, no real charge".into(),
+    }
