+        storage_bytes: Some(TEST_STORAGE_BYTES),
+        max_file_bytes: Some(TEST_FILE_BYTES),
+        retention_seconds: Some(TEST_RETENTION_SECONDS),
+        instructions: "Fixture only; no payment is collected.".into(),
+    }
+}
