  "spec": {
    "description": "Find Resident tools by required capabilities, scope, operation, and authorized effect mode. Natural-language task text ranks only candidates that pass Runtime gates; matches never execute a target tool, and newly activated deferred tools become visible in the next sampling.",
    "name": "tool.search",
    "parameters": {
      "additionalProperties": false,
      "description": "Matches include use_when/avoid_when. Unmet capabilities have capability-level reasons. Optional next_searches entries are complete arguments for tool.search; choose one only if useful. Discovery and recovery suggestions do not execute matched tools or grant permissions.",
      "examples": [
        {
          "effect_mode": "read_only",
          "max_results": 2,
          "operation": "summarize",
          "required_capabilities": [
            "structural_index"
          ],
          "scope": "document",
          "task": "Outline the main argument of this book without moving the Reader"
        },
        {
          "effect_mode": "read_only",
          "max_results": 1,
          "operation": "locate_literal",
          "required_capabilities": [
            "lexical_locate"
          ],
          "scope": "document",
          "task": "Find the first literal occurrence of equal time"
        },
        {
          "effect_mode": "read_only",
          "max_results": 1,
          "operation": "read_source",
          "required_capabilities": [
            "source_read"
          ],
          "scope": "passage",
          "task": "Read the passage selected from the search results"
        },
        {
          "effect_mode": "reader_mutation_explicitly_requested",
          "max_results": 2,
          "operation": "mutate_reader",
          "required_capabilities": [
            "reader_write"
          ],
          "scope": "passage",
          "task": "Save the user's requested note on the current passage"
        }
      ],
      "properties": {
        "effect_mode": {
          "enum": [
            "read_only",
            "reader_mutation_explicitly_requested"
          ],
          "type": "string"
        },
        "max_results": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "enum": [
            "locate_literal",
            "read_source",
            "explain",
            "compare",
            "summarize",
            "navigate",
            "mutate_reader"
          ],
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "discovery",
              "source_read",
              "lexical_locate",
              "semantic_evidence",
              "structural_index",
              "synthesis",
              "navigation_plan",
              "artifact_read",
              "source_presentation",
              "presentation_authoring",
              "profile_read",
              "profile_trace",
              "memory_read",
              "memory_write",
              "reader_read",
              "reader_write",
              "goal_management"
            ],
            "type": "string"
          },
          "maxItems": 17,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "enum": [
            "selection",
            "passage",
            "section",
            "document",
            "corpus"
          ],
          "type": "string"
        },
        "task": {
          "description": "Natural-language task used only to rank already-authorized candidates",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task",
        "required_capabilities",
        "scope",
        "operation",
        "effect_mode",
        "max_results"
      ],
      "type": "object"
    }
  }
