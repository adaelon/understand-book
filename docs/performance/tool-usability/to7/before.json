  "spec": {
    "description": "Find Resident tools by required capabilities, scope, operation, and authorized effect mode. Natural-language task text ranks only candidates that pass Runtime gates; matches never execute a target tool, and newly activated deferred tools become visible in the next sampling.",
    "name": "tool.search",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "effect_mode": {
          "enum": [
            "read_only",
            "reader_mutation_explicitly_requested"
          ],
          "type": "string"
        },
        "max_results": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "enum": [
            "locate_literal",
            "read_source",
            "explain",
            "compare",
            "summarize",
            "navigate",
            "mutate_reader"
          ],
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "enum": [
              "discovery",
              "source_read",
              "lexical_locate",
              "semantic_evidence",
              "structural_index",
              "synthesis",
              "navigation_plan",
              "artifact_read",
              "source_presentation",
              "presentation_authoring",
              "profile_read",
              "profile_trace",
              "memory_read",
              "memory_write",
              "reader_read",
              "reader_write",
              "goal_management"
            ],
            "type": "string"
          },
          "maxItems": 17,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "enum": [
            "selection",
            "passage",
            "section",
            "document",
            "corpus"
          ],
          "type": "string"
        },
        "task": {
          "description": "Natural-language task used only to rank already-authorized candidates",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task",
        "required_capabilities",
        "scope",
        "operation",
        "effect_mode",
        "max_results"
      ],
      "type": "object"
    }
  }
