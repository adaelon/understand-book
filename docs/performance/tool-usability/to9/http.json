  "tool": {
    "description": "Return context pointers for a LID: near adds tree adjacency and local edges, mid adds other concept or entity occurrences, and far adds long-range edges. Counts cover only known rule-recalled pointers, not all semantic relations; built structure availability is reported by book_structure. Pointers contain no source text; use book_text to read it. Use when: Expand around a verified LID through deterministic context links. Do not treat pointers as source text.  Returns a built projection in data, not a generated answer. Collections are paged: data_path identifies a continuation's collection in the original projection and total_items its size. next_calls may include multiple collection branches and search batches. Concept matched_count/truncated still describe bounded candidate recall. Read chosen evidence LIDs with book_text. Missing built capability returns material_unavailable. Copy published_book_ref from book_list and check its available_tools. Costs 1 call on success, including empty results, each continuation page and repeated successful requests; failures cost 0. complete=false means more pages exist; copy needed next_calls name and arguments unchanged. sources gives published_book_ref, start_lid/end_lid, source_range and source_url: cite only evidence actually read, retaining its version and exact range. An empty sources array provides no source citation. usage is the server's post-call balance with charged_units and charged_from; do not infer balance locally. On quota_exhausted stop content retries and report usage.free_resets_at plus top_up_url or top_up_instruction; book_list and mcp_usage remain free.",
    "inputSchema": {
      "additionalProperties": false,
      "examples": [
        {
          "granularity": "near",
          "k": 3,
          "lid": "1.2",
          "published_book_ref": {
            "book_id": "tool-example-book",
            "publication_id": "01a12e56-390d-7003-b0dd-733f0fd292a3"
          }
        }
      ],
      "properties": {
        "granularity": {
          "anyOf": [
            {
              "enum": [
                "near",
                "mid",
                "far"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "near",
          "description": "Context reach: near includes tree adjacency and local relations; mid adds other concept/entity occurrences; far also adds long-range relations. Omit or null for near."
        },
        "k": {
          "default": 10,
          "description": "Maximum number of context pointers returned across all layers. Omit or null for 10; zero returns no items. total_candidates counts deduplicated pointers before k; returned_count and truncated describe selection by k before pagination or output budgeting. Counts pointers, not distinct LIDs, characters or source passages.",
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lid": {
          "description": "Known LID in this book to expand around. Returned items are context pointers; read their LIDs through the source-text tool for evidence.",
          "type": "string"
        },
        "page": {
          "additionalProperties": false,
          "description": "Copy a continuation from next_calls to read an omitted collection. data_path identifies its position in the full projection.",
          "properties": {
            "limit": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "published_book_ref": {
          "additionalProperties": false,
          "description": "Copy the exact immutable publication reference from book_list; keep both identifiers on every content call and continuation.",
          "properties": {
            "book_id": {
              "description": "Material identifier returned by book_list.",
              "minLength": 1,
              "type": "string"
            },
            "publication_id": {
              "description": "Exact publication version returned by book_list.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "book_id",
            "publication_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "lid",
