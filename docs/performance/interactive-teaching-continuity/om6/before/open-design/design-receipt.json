{
  "design": {
    "basis_refs": [
      "usage:tutor-begin-1:user:turn_2afb3b85d604d168"
    ],
    "blocks": [
      {
        "block_id": "total-time",
        "purpose": "让读者看清总时间由行驶时间和停留时间两部分组成，从而知道缩短总时间有两条互不替代的入口。",
        "relation": "同一路线的总时间 = 行驶时间 + 停留时间。行驶时间由路程和行驶速度决定；停留时间由各次停留的时长相加。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      },
      {
        "block_id": "average-speed",
        "purpose": "让读者能用总路程和总时间算出全程平均速度，并看出它同时受行驶速度和停留时间影响。",
        "relation": "全程平均速度 = 总路程 ÷ 总时间。总路程不变时，总时间变小，平均速度变大；只提高行驶速度而停留时间不变，总时间的下降幅度受停留时间占比限制。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      },
      {
        "block_id": "tradeoff",
        "purpose": "让读者能比较两类方案各自的收益上限与代价，做出取舍而不是寻找唯一答案。",
        "relation": "减少非必要停留：直接削减停留时间，收益等于削减的时长，但必要休息不能削减。提高行驶速度：只压缩行驶时间，收益 = 原行驶时间 − 新行驶时间，受安全条件限制，且速度越高单位时间收益越小。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      }
    ],
    "connections": [],
    "focus_block_refs": [
      "total-time",
      "average-speed",
      "tradeoff"
    ],
    "open_question_refs": [],
    "organizing_model": "用户要求深入分析同一路线缩短总时间的多种方案，并直接给出公式、比较方法和取舍。核心关系是总时间由行驶时间与停留时间相加构成，因此两类方案分别作用于其中一项；比较时看各自能压缩多少总时间、代价是什么。必要休息作为不可削减的约束保留。",
    "previous_ref": "design:turn_2afb3d85d604d4ce:om6-prior",
    "representation": {
      "kind": "text",
      "reason": "用户要求直接给公式、比较方法和取舍，用文字加公式即可把两项时间的分解和各自收益讲清，无需额外页面。"
    },
    "revision_reason": "用户明确要求深入分析多种方案、直接给公式与比较方法，不再停留在“速度和停留都影响总时间”的一句话；同时保留必要休息这一约束。",
    "target": {
      "capability": "explanation",
      "expected_performance": "能用总时间=行驶时间+停留时间的分解，分别估算减少非必要停留与提高行驶速度各自压缩的总时间，并说明两者的收益上限与代价",
      "learning_focus": "同一路线缩短总时间的方案比较",
      "object_refs": [],
      "source_bindings": [
        {
          "end_lid": "1.1",
          "source_id": "sample-book",
          "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
          "start_lid": "1.1"
        }
      ]
    }
  },
