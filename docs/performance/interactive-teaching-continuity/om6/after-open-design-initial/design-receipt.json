{
  "design": {
    "basis_refs": [
      "usage:tutor-begin-1:user:turn_057e7341aba18515"
    ],
    "blocks": [
      {
        "block_id": "total-time",
        "purpose": "把总时间拆成行驶时间与停留时间，使“缩短总时间”有可分别调整的两部分。",
        "relation": "总时间 = 行驶时间 + 停留时间；行驶时间 = 路程 ÷ 行驶速度。因此总时间 = 路程 ÷ 行驶速度 + 停留时间。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      },
      {
        "block_id": "average-speed",
        "purpose": "说明为什么提高行驶速度的收益会递减，以及平均速度为何不能只看行驶速度。",
        "relation": "平均速度 = 总路程 ÷ 总时间。路程固定时，提高行驶速度只压缩行驶时间这一项，停留时间不变，所以总时间的下降幅度随速度提高而变小；平均速度的分母含停留时间，故低于行驶速度。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      },
      {
        "block_id": "tradeoff",
        "purpose": "给出比较两种方案的方法与取舍依据，而不是唯一答案。",
        "relation": "对每个方案分别算出新的行驶时间与停留时间，相加得总时间，再与基准比较节省量；同时检查该方案是否满足必要休息与安全条件。节省量相近时，按安全余量、疲劳程度和可行性取舍。",
        "source_bindings": [
          {
            "end_lid": "1.1",
            "source_id": "sample-book",
            "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
            "start_lid": "1.1"
          }
        ]
      }
    ],
    "connections": [],
    "focus_block_refs": [
      "total-time",
      "average-speed",
      "tradeoff"
    ],
    "open_question_refs": [],
    "organizing_model": "用户要求深入分析同一路线缩短总时间的多种合理方案，并直接给出公式、比较方法和取舍。核心关系是总时间由行驶时间与停留时间两部分相加，路程固定时两条路径分别压缩其中一项；比较方案要回到总时间，并保留必要休息与安全条件。",
    "previous_ref": "design:turn_057e7141aba181af:om6-prior",
    "representation": {
      "kind": "text",
      "reason": "用户要求直接给公式、比较方法和取舍，文字加一个数值例子即可把两部分时间与节省量算清楚，无需页面。"
    },
    "revision_reason": "用户明确要求深入分析、直接给公式与比较方法，并说明减少非必要停留与安全提速两条路径都可考虑；这超出原先只区分行驶时间与总时间的单块设计，故扩展为三块并保留 total-time。",
    "target": {
      "capability": "explanation",
      "expected_performance": "用总时间公式分别估算“减少非必要停留”和“安全提速”两类方案各自节省的时间，并说明在保留必要休息与安全条件下如何比较取舍。",
      "learning_focus": "同一路线缩短总时间的方案比较",
      "object_refs": [],
      "source_bindings": [
        {
          "end_lid": "1.1",
          "source_id": "sample-book",
          "source_revision": "7f231adcec5094d4b9aab7e02729d04d9f42698c706d0fb7e7c74d1e3ff95b75",
          "start_lid": "1.1"
        }
      ]
    }
  },
