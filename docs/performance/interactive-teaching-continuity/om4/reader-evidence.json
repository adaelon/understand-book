    "animation_assets": {},
    "assumptions": [],
    "content_files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>速度输入与显示结果</title>\n<style>\n  body { margin: 0; padding: 24px; color: #233e40; background: #f5f4ed; font: 16px/1.6 sans-serif; }\n  main { max-width: 620px; margin: auto; }\n  label { display: block; margin: 12px 0; }\n  input, button { font: inherit; min-height: 44px; }\n  input { width: 90px; }\n  button { margin: 4px; padding: 4px 12px; }\n  svg { display: block; width: 100%; }\n</style>\n<main>\n  <h1>改了输入，画面为什么还没变？</h1>\n  <p>A 的速度固定为 1 m/s。B 的速度在应用完成后更新，两辆车使用同一时钟。</p>\n  <label>B 的输入速度（m/s） <input data-presentation-parameter=\"input_speed_b_m_s\" id=\"speed\" type=\"number\" min=\"0\" max=\"3\" step=\".5\" value=\"1\"></label>\n  <button data-presentation-action=\"apply\" id=\"apply\">应用</button><button id=\"cancel\" disabled>取消计算</button>\n  <button id=\"play\">播放</button><button id=\"pause\">暂停</button><button data-presentation-action=\"reset\" id=\"reset\">重置</button>\n  <p id=\"phase\"></p>\n  <svg viewBox=\"0 0 360 100\" role=\"img\" aria-label=\"共同时间下的距离对照\">\n    <text x=\"4\" y=\"30\">A</text><rect id=\"a\" x=\"30\" y=\"12\" height=\"20\" fill=\"#18857e\"></rect>\n    <text x=\"4\" y=\"75\">B</text><rect id=\"b\" x=\"30\" y=\"57\" height=\"20\" fill=\"#c38a35\"></rect>\n  </svg>\n  <p id=\"result\"></p>\n  <p id=\"relation\" hidden>同一时间内，速度翻倍，距离也翻倍。</p>\n  <p id=\"annotation\" hidden>比较时保持共同时间不变。</p>\n</main>\n<script>\n  const defaults = { input_speed_b_m_s: 1, applied_speed_b_m_s: 1, time_s: 10, phase: 'ready', revealed: false, annotated: false };\n  const model = { ...defaults, ...window.presentation?.initialState, playing: false };\n  const $ = id => document.getElementById(id);\n  let calculation, playback, rejectCalculation;\n  function cancelCalculation() { clearTimeout(calculation); rejectCalculation?.(new Error(\"Calculation cancelled\")); rejectCalculation = undefined; }\n  const result = () => ({\n    speed_b_m_s: model.applied_speed_b_m_s, time_s: model.time_s,\n    distance_a_m: model.time_s, distance_b_m: model.applied_speed_b_m_s * model.time_s,\n  });\n  const commit = () => window.presentation?.commitState();\n  function stop() { clearInterval(playback); model.playing = false; }\n  function render() {\n    const shown = result();\n    $('speed').value = model.input_speed_b_m_s;\n    $('relation').hidden = !model.revealed; $('annotation').hidden = !model.annotated;\n    $('phase').textContent = { ready: '结果已应用', awaiting_apply: '等待应用', calculating: '计算中，仍显示旧结果', cancelled: '计算已取消，仍显示旧结果' }[model.phase];\n    $('result').textContent = `画面：${shown.time_s.toFixed(1)} 秒，A 走 ${shown.distance_a_m.toFixed(1)} 米，B 走 ${shown.distance_b_m.toFixed(1)} 米；已应用 B 速度 ${shown.speed_b_m_s} m/s。`;\n    $('a').setAttribute('width', shown.distance_a_m * 10);\n    $('b').setAttribute('width', shown.distance_b_m * 10);\n    $('cancel').disabled = model.phase !== 'calculating';\n  }\n  function setSpeed(value) {\n    cancelCalculation();\n    model.input_speed_b_m_s = Number(value);\n    model.phase = model.input_speed_b_m_s === model.applied_speed_b_m_s ? 'ready' : 'awaiting_apply';\n    render();\n  };\n  $('speed').oninput = () => setSpeed($('speed').value);\n  function apply(signal) {\n    cancelCalculation(); stop();\n    const speed = model.input_speed_b_m_s;\n    model.phase = 'calculating'; render();\n    return new Promise((resolve, reject) => {\n      const abort = () => { cancelCalculation(); model.phase = 'cancelled'; render(); };\n      rejectCalculation = failure => { signal?.removeEventListener('abort', abort); reject(failure); };\n      signal?.addEventListener('abort', abort, { once: true });\n      calculation = setTimeout(() => {\n        signal?.removeEventListener('abort', abort); rejectCalculation = undefined;\n        model.applied_speed_b_m_s = speed; model.phase = 'ready'; render(); commit(); resolve();\n      }, 500);\n    });\n  };\n  $('apply').onclick = () => { void apply().catch(() => {}); };\n  $('cancel').onclick = () => { cancelCalculation(); model.phase = 'cancelled'; render(); commit(); };\n  $('play').onclick = () => {\n    stop(); model.playing = true;\n    if (model.time_s === 10) model.time_s = 0;\n    render();\n    playback = setInterval(() => {\n      model.time_s = Math.min(10, Math.round((model.time_s + .1) * 10) / 10);\n      if (model.time_s === 10) { stop(); render(); commit(); } else render();\n    }, 100);\n  };\n  $('pause').onclick = () => { stop(); render(); commit(); };\n  function reset() { cancelCalculation(); stop(); Object.assign(model, defaults); render(); commit(); }\n  $('reset').onclick = reset;\n  window.presentation?.registerActionHandler?.(async (action, { signal } = {}) => {\n    if (action.kind === 'set_parameters') setSpeed(action.values.input_speed_b_m_s);\n    else if (action.kind === 'invoke' && action.action_id === 'apply') await apply(signal);\n    else if (action.kind === 'invoke' && action.action_id === 'reset') reset();\n    else if (action.kind === 'reveal') { model.revealed = true; render(); }\n    else if (action.kind === 'annotate') { model.annotated = true; render(); }\n  });\n  window.presentation?.registerStateReader(() => ({\n    values: { input_speed_b_m_s: model.input_speed_b_m_s, applied_speed_b_m_s: model.applied_speed_b_m_s, time_s: model.time_s, phase: model.phase, revealed: model.revealed, annotated: model.annotated },\n    visible_step: model.phase,\n    observation: {\n      summary: `B 的输入速度为 ${model.input_speed_b_m_s} m/s；画面按 ${model.applied_speed_b_m_s} m/s 显示 ${model.time_s} 秒、${result().distance_b_m} 米。${$('phase').textContent}`,\n      state: { speed_b_m_s: model.input_speed_b_m_s, time_s: model.time_s, phase: model.phase, playing: model.playing },\n      rendered: result(),\n    },\n  }));\n  window.presentation?.registerStateRestorer(saved => {\n    clearTimeout(calculation); stop();\n    Object.assign(model, saved.values.page);\n    if (model.phase === 'calculating') model.phase = 'awaiting_apply';\n    render();\n  });\n  render();\n</script>\n</html>\n"
    },
