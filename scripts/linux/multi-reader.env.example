UNDERSTAND_BOOK_MODE=multi-user
UNDERSTAND_BOOK_SERVICE_ROOT=/opt/understand-book/data/multi-reader
UNDERSTAND_BOOK_ORIGIN=https://reader.example
# Keep the backend separate from the old single-reader instance.
UNDERSTAND_BOOK_ADDR=127.0.0.1:8788
UNDERSTAND_BOOK_PROVIDER=native
# Fill these in the private systemd EnvironmentFile, mode 0600.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
FLUID_LLM_MODEL=
UB_OBSERVABILITY_MODE=off

# INV3: Resend account mail. Leave all four unset/empty until configured.
# FROM is a plain mailbox on a verified sending domain. Keep the API key in
# the private systemd EnvironmentFile (0600), alongside the model credentials.
UNDERSTAND_BOOK_MAIL_FROM=
UNDERSTAND_BOOK_MAIL_API_KEY=
# Defaults when FROM/API_KEY are configured: https://api.resend.com/emails, 10s.
# Local protocol testing may use http://127.0.0.1:<port>/emails (dummy key only).
UNDERSTAND_BOOK_MAIL_ENDPOINT=
UNDERSTAND_BOOK_MAIL_TIMEOUT_SECONDS=
# Shared limits: one attempt per mailbox per 60s; 60 attempts per rolling minute.
# Failed attempts count. Links always use UNDERSTAND_BOOK_ORIGIN above.
