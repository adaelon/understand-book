// The dedicated host account launches and reclaims the fixed renderer jobs.
// systemd 252 does not provide a unit detail for StartTransientUnit, so this
// grants manage-units to the trusted host account (not manage-unit-files).
// Generated code runs as nobody inside bubblewrap without the host D-Bus.
polkit.addRule(function(action, subject) {
    if (subject.user === "understand-book" && action.id === "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
